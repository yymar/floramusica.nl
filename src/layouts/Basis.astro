---
/**
 * Basislayout: fonts, meta, SEO, skip-link, header en footer.
 * Alleen de latin-subsets van de fonts worden geladen.
 */
// De standard-subset: alle assen (wght, wdth én opsz) — de sectiekoppen
// gebruiken de optische as, zie .kop-display in global.css.
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400-italic.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Wind from '../components/ornaments/Wind.astro';
import { site } from '../data/site';
import { copy, taalVan } from '../data/copy';

interface Props {
  /** Paginatitel; de sitenaam wordt er automatisch achter gezet. */
  titel?: string;
  omschrijving?: string;
  /** 404 en bedankt-pagina willen geen indexering. */
  noindex?: boolean;
}
const taal = taalVan(Astro.currentLocale);
const { basis } = copy(Astro.currentLocale);
const standaardOmschrijving = taal === 'en' ? site.omschrijvingEn : site.omschrijving;
const { titel, omschrijving = standaardOmschrijving, noindex = false } = Astro.props;
const volledigeTitel = titel ? `${titel} · ${site.naam}` : `${site.naam} · ${basis.titelRest}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// hreflang-alternates: dezelfde pagina in beide talen.
const nlPad = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const enPad = nlPad === '/' ? '/en/' : `/en${nlPad}`;
---

<!doctype html>
<html lang={taal}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{volledigeTitel}</title>
    <meta name="description" content={omschrijving} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="nl" href={new URL(nlPad, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPad, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(nlPad, Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.naam} />
    <meta property="og:title" content={volledigeTitel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={taal === 'en' ? 'en_US' : 'nl_NL'} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={basis.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:title" content={volledigeTitel} />
    <meta name="twitter:description" content={omschrijving} />

    <meta name="generator" content={Astro.generator} />
    {
      taal === 'nl' && (
        <script is:inline>
          // Nederlands is de standaard, ook voor Engelstalige browsers en in
          // incognito. Alleen een eerdere expliciete keuze voor Engels (via de
          // taalknop, bewaard als fm:taal) stuurt door naar /en/.
          try {
            if (localStorage.getItem('fm:taal') === 'en') {
              location.replace('/en' + location.pathname + location.hash);
            }
          } catch (e) {}
        </script>
      )
    }
    <JsonLd />
  </head>
  <body>
    <a
      href="#inhoud"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-paper focus:px-4 focus:py-2 focus:font-bold focus:text-bordeaux"
    >
      {basis.skiplink}
    </a>
    <div id="top"></div>
    <Header />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
    <Wind />
  </body>
</html>
