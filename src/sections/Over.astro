---
/**
 * Tekst en foto komen na de kop binnen, in die volgorde (r2, dan r3) —
 * zie MOTION.md.
 */
import Sectie from '../components/Sectie.astro';
import Figuur from '../components/Figuur.astro';
import { copy } from '../data/copy';
const { over } = copy(Astro.currentLocale);
import lespraktijk from '../assets/lespraktijk.jpg';
---

<Sectie id="over" label={over.label} kop={over.kop} sier="blad-1">
  {/* Op mobiel: praktijk, foto, biografie — de foto breekt de lange tekst.
      Vanaf sm staat de foto rechts en loopt hij sticky mee langs beide
      tekstblokken, zodat de rechterkolom niet leeg valt. */}
  <div class="grid gap-10 sm:grid-cols-[2fr_1fr]">
    <div class="rijs r2 max-w-[62ch] space-y-4 sm:col-start-1 sm:row-start-1">
      {over.alineas.map((alinea) => <p>{alinea}</p>)}
    </div>
    <div class="rijs r3 self-start sm:sticky sm:top-24 sm:col-start-2 sm:row-span-2 sm:row-start-1">
      <Figuur
        src={lespraktijk}
        alt={over.fotoAlt}
        breedte={600}
        hoogte={800}
        focus="50% 35%"
        class="max-w-[16rem] sm:max-w-none"
      />
    </div>
    <div class="rijs max-w-[62ch] space-y-4 sm:col-start-1 sm:row-start-2">
      <h3 class="font-display text-subkop font-semibold text-ink">{over.bioKop}</h3>
      {over.bio.map((alinea) => <p>{alinea}</p>)}
    </div>
  </div>
</Sectie>
