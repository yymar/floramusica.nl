---
/**
 * Tarieven en lesduur. Zolang prijslijst.bekend false is, blijft de sectie
 * kort: één zin plus een verwijzing naar het contactformulier. Geen lege
 * tabel met "op aanvraag"; regel is weglaten, nooit placeholder tonen.
 * Zodra de tarieven zijn ingevuld (`bekend: true` in src/data/tarieven.ts)
 * verschijnt de volledige lijst vanzelf.
 */
import Sectie from '../components/Sectie.astro';
import { copy } from '../data/copy';
import { tarieven } from '../data/tarieven';
import { handigeLinks } from '../data/links';
import ExterneLink from '../components/ExterneLink.astro';
const { praktisch } = copy(Astro.currentLocale);
const prijslijst = tarieven(Astro.currentLocale);
const links = handigeLinks(Astro.currentLocale);
---

<Sectie id="praktisch" label={praktisch.label} kop={praktisch.kop} tint>
  <p class="rijs r2 max-w-[62ch]">
    {praktisch.intro}{' '}
    {praktisch.introVraagVoor}{' '}<a
      href="#contact"
      class="text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep"
    >{praktisch.introVraagLink}</a>.
  </p>

  {
    prijslijst.bekend && (
      <dl class="mt-8 max-w-xl">
        {prijslijst.lesvormen.map((lesvorm) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-rule py-4">
            <dt>
              <span class="font-bold">{lesvorm.naam}</span>
              {lesvorm.duur && <span class="block text-klein text-ink-soft">{lesvorm.duur}</span>}
            </dt>
            <dd class="text-right whitespace-nowrap">{lesvorm.prijs || praktisch.opAanvraag}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    prijslijst.bekend && prijslijst.opmerkingen.length > 0 && (
      <ul class="mt-6 max-w-[62ch] space-y-2 text-klein text-ink-soft">
        {prijslijst.opmerkingen.map((opmerking) => (
          <li>{opmerking}</li>
        ))}
      </ul>
    )
  }

  <div class="rijs r3 mt-12">
    <h3 class="font-display text-subkop font-semibold text-ink">{praktisch.linksKop}</h3>
    <ul class="mt-4 max-w-xl">
      {
        links.map((link) => (
          <li class="border-b border-rule py-3">
            {link.url ? <ExterneLink href={link.url}>{link.naam}</ExterneLink> : <span class="font-bold">{link.naam}</span>}
            <span class="block text-klein text-ink-soft">{link.omschrijving}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Sectie>
