---
/**
 * Lesaanbod als programma. Het hoofdinstrument (klarinet) opent als een
 * bordeaux vlak dat rechts uit de container bloedt tot de paginarand en
 * zich bij het inscrollen links-naar-rechts opent — de crescendo uit
 * MOTION.md. De overige instrumenten volgen als rustige lijst op hairlines
 * die per item aangroeien, dezelfde taal als de organisatielijst bij
 * Locatie. Geen kaartjes; het programmaboekje zet zijn repertoire onder
 * elkaar.
 *
 * Vlak en tekst komen samen op, dus er is geen moment waarop lichte tekst
 * op licht papier staat.
 */
import Sectie from '../components/Sectie.astro';
import Sprig from '../components/ornaments/Sprig.astro';
import { instrumenten, doelgroepen } from '../data/instrumenten';
import { lessen } from '../data/copy';
// Zelfde handgetekende klarinet als op de omslag (Imke, Procreate):
// crème lijnen, dus op het bordeaux vlak als <img> met lage dekking.
import klarinetImke from '../assets/imke-klarinet-creme.png';

const hoofd = instrumenten.find((i) => i.hoofdinstrument);
const overige = instrumenten.filter((i) => !i.hoofdinstrument);
---

<Sectie id="lessen" label="Lessen" kop={lessen.kop} tint>
  <p class="rijs r2 max-w-[62ch]">{lessen.intro}</p>

  {
    hoofd && (
      <article class="golf-plaat">
        {/* De klarinet — Imkes tekening, dezelfde als op de omslag — staat
            als hoge accentkolom tegen de rechterkant van het vlak en loopt
            aan de bovenkant het vlak uit; de clip van het vlak maakt daar
            een bewuste snede van. Gecomponeerd op het blok, niet erbovenop. */}
        <div class="golf-klarinet" aria-hidden="true">
          <img src={klarinetImke.src} alt="" width={klarinetImke.width} height={klarinetImke.height} loading="lazy" />
        </div>
        <h3 class="font-display text-subkop font-semibold text-paper">{hoofd.naam}</h3>
        <p class="mt-2 max-w-[52ch] text-paper-dim">{hoofd.omschrijving}</p>
      </article>
    )
  }

  <div class="instr-grid">
    {
      overige.map((instrument, i) => (
        <article class="instr">
          {/* De tekst rijst mee met de lijn erboven; per paar een stap later,
              zodat de lijst zich opbouwt in plaats van in één klap te staan. */}
          <div class:list={['rijs', ['', 'r2', 'r2', 'r3'][i] || 'r3']}>
            <h3 class="font-display text-[1.1rem] leading-snug font-semibold text-ink">
              {instrument.naam}
            </h3>
            <p class="mt-1 text-klein text-ink-soft">{instrument.omschrijving}</p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="rijs doelgroep mt-10">
    <h3 class="font-display text-subkop font-semibold text-ink">
      {lessen.doelgroepLabel}
      <Sprig name="noten-blad" class="kop-takje text-bordeaux opacity-55" />
    </h3>
    <p class="mt-2 max-w-[62ch]">{lessen.doelgroepTekst}</p>
    <p class="mt-3 text-klein text-ink-soft" aria-label="Doelgroepen">
      {doelgroepen.map((groep, i) => (
        <>
          <span class="capitalize">{groep}</span>
          {i < doelgroepen.length - 1 && <span aria-hidden="true"> · </span>}
        </>
      ))}
    </p>
  </div>

</Sectie>

<style>
  /* De klarinet staat op de bodem van het vlak en is hoger dan het vlak
     zelf, dus hij loopt er aan de bovenkant uit; `overflow: clip` op het
     vlak maakt daar een bewuste snede van. De tekening is strak op de
     inhoud bijgesneden, dus een kleine positieve inzet zet het instrument
     tegen de rand. */
  .golf-plaat :global(.golf-klarinet) {
    position: absolute;
    /* Lucht onder de bloem: op de rand plakken oogt als een afsnede. */
    bottom: 1.25rem;
    right: 1.25rem;
    height: calc(100% + 2.5rem);
    aspect-ratio: 323 / 900;
    opacity: 0.2;
    pointer-events: none;
  }
  .golf-plaat :global(.golf-klarinet img) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 48rem) {
    .golf-plaat :global(.golf-klarinet) {
      bottom: 1.5rem;
      right: 2.5rem;
      height: calc(100% + 3.5rem);
      opacity: 0.22;
    }
  }

  /* Drukkersornament: absoluut in de goot links van de kop, zodat de kop
     zelf op de gridlijn blijft staan — accenten verplaatsen nooit tekst.
     Onder 48rem bestaat de goot niet en is het accent er niet. */
  .doelgroep h3 {
    position: relative;
  }
  .doelgroep :global(.kop-takje) {
    display: none;
    position: absolute;
    width: 2.5rem;
    right: calc(100% + 0.9rem);
    top: 50%;
    translate: 0 -50%;
  }
  @media (min-width: 48rem) {
    .doelgroep :global(.kop-takje) {
      display: block;
    }
  }

  /* Het vlak bloedt rechts uit de container tot de paginarand en schuift
     zich bij het inscrollen naar rechts open (golf-open) — de crescendo
     uit MOTION.md. `calc(50% - 50vw)` zou alleen kloppen voor een
     gecentreerd blok; dit rekent de echte marge uit. */
  .golf-plaat {
    --bleed: calc(max(0px, (100vw - 64rem) / 2) + 1.25rem);
    position: relative;
    z-index: var(--z-inhoud);
    overflow: clip;
    margin-top: 0.75rem;
    margin-right: calc(-1 * var(--bleed));
    border-radius: 2px 0 0 2px;
    background: var(--color-bordeaux-deep);
    padding: 2rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .golf-plaat {
      --bleed: calc(max(0px, (100vw - 64rem) / 2) + 2rem);
    }
  }
  @media (min-width: 48rem) {
    .golf-plaat {
      padding: 2.5rem 3rem 2.5rem 2.5rem;
    }
  }

  .instr-grid {
    margin-top: 2rem;
    display: grid;
    column-gap: 2.5rem;
  }
  @media (min-width: 40rem) {
    .instr-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* De hairline is een pseudo-element en geen border: alleen zo kan hij van
     links aangroeien in plaats van er in één keer staan. */
  .instr {
    position: relative;
    padding-block: 1rem;
  }
  .instr::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-rule);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* clip-path en niet width: zo herflowt de tekst binnenin niet terwijl
         het vlak opengaat. */
      .golf-plaat {
        animation-name: golf-open;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% entry 70%;
      }
      .instr::before {
        animation-name: lijn-groei;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
      .instr:nth-child(2)::before {
        animation-range: entry 7% entry 42%;
      }
      .instr:nth-child(3)::before {
        animation-range: entry 14% entry 49%;
      }
      .instr:nth-child(4)::before {
        animation-range: entry 21% entry 56%;
      }
    }
  }

  @keyframes golf-open {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
