---
import Sectie from '../components/Sectie.astro';
import ContactFormulier from '../components/ContactFormulier.astro';
import { copy } from '../data/copy';
const { contact } = copy(Astro.currentLocale);
import { site } from '../data/site';
---

<Sectie id="contact" label={contact.label} kop={contact.kop}>
  <p class="rijs r2 max-w-[62ch]">{contact.intro}</p>

  <div class="mt-8">
    <ContactFormulier />
  </div>

  {
    site.email && (
      <p class="mt-8 text-klein text-ink-soft">
        {contact.mailtoTekst}{' '}
        <a href={`mailto:${site.email}`} class="text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep">
          {site.email}
        </a>
      </p>
    )
  }
</Sectie>
