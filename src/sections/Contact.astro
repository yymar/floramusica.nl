---
import Sectie from '../components/Sectie.astro';
import ContactFormulier from '../components/ContactFormulier.astro';
import TextuurBand from '../components/ornaments/TextuurBand.astro';
import Stengel from '../components/ornaments/Stengel.astro';
import { contact } from '../data/copy';
import { site } from '../data/site';
---

<Sectie id="contact" label="Contact" kop={contact.kop} band>
  {/* De draad die Praktisch en Contact aan elkaar knoopt: het lint naadloos
      geketend over de volle vensterbreedte, half boven en half onder de
      grens, achter beide achtergronden langs. */}
  <TextuurBand slot="band" dekking={0.07} />
  {/* Het laatste segment loopt donkerder aan (verloop in Stengel.astro):
      bovenin de tekstdekking, op de landing de volle dekking van de
      footerbalk, zodat de overgang naadloos is. */}
  <Stengel slot="band" deel="contact" dekking={0.5} class="stengel-verloop" />
  <p class="rijs r2 max-w-[62ch]">{contact.intro}</p>

  <div class="mt-8">
    <ContactFormulier />
  </div>

  {
    site.email && (
      <p class="mt-8 text-klein text-ink-soft">
        {contact.mailtoTekst}{' '}
        <a href={`mailto:${site.email}`} class="text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep">
          {site.email}
        </a>
      </p>
    )
  }
</Sectie>
