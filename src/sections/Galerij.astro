---
/**
 * De galerij als quilted/editorial grid: een gecureerde spread, geen
 * fotorol. CSS Grid met dense flow; per foto bepaalt `formaat` uit de
 * data-file de cel (groot 2×2, middel 1×2 of 2×1 naar oriëntatie,
 * klein 1×1). Mobiel 2 kolommen, vanaf 48rem 4. Bijschriften liggen als
 * subtiele overlay op hover/focus en staan altijd in de lightbox.
 *
 * Lightbox: native <dialog>. Bladeren zonder lag: buren (n−1, n+1)
 * worden voorgeladen, bij een wissel staat direct de thumbnail (al in
 * cache) licht geblurd klaar en pas na `img.decode()` cross-fadet de
 * hoge resolutie erin. Eigen srcset (800/1600 webp), teller, spinner na
 * 400ms, Nederlandse foutmelding met opnieuw-knop. Zonder JavaScript
 * linkt elke cel gewoon naar het beeldbestand.
 */
import { getImage } from 'astro:assets';
import { Image } from 'astro:assets';
import Sectie from '../components/Sectie.astro';
import Stengel from '../components/ornaments/Stengel.astro';
import { fotos } from '../data/fotos';
import { galerij } from '../data/copy';

type Cel = {
  foto: (typeof fotos)[number];
  nummer: number;
  span: 'groot' | 'staand' | 'liggend' | 'klein';
  thumb?: string;
  srcset?: string;
  groot?: string;
};

// Lightbox-varianten: eigen srcset (max 1600px, webp) plus een kleine
// thumb voor de instant blur-up.
const cellen: Cel[] = await Promise.all(
  fotos.map(async (foto, i): Promise<Cel> => {
    const liggend = (foto.src?.width ?? 0) > (foto.src?.height ?? 1);
    const span =
      foto.formaat === 'groot' ? 'groot' : foto.formaat === 'middel' ? (liggend ? 'liggend' : 'staand') : 'klein';
    if (!foto.src) return { foto, nummer: i + 1, span };
    const [klein, middel, groot] = await Promise.all([
      getImage({ src: foto.src, width: 400, format: 'webp' }),
      getImage({ src: foto.src, width: 800, format: 'webp' }),
      getImage({ src: foto.src, width: 1600, format: 'webp' }),
    ]);
    return {
      foto,
      nummer: i + 1,
      span,
      thumb: klein.src,
      srcset: `${middel.src} 800w, ${groot.src} 1600w`,
      groot: groot.src,
    };
  })
);
---

{
  fotos.length > 0 && (
    <Sectie id="beelden" label="Beelden" kop={galerij.kop} sier="bloem-open" band>
      {/* De stengel neemt hier de verbindende rol; langs de buitenmarge
          van het grid, nooit door de foto's. */}
      <Stengel slot="band" deel="beelden" />
      <div class="grid-quilt" id="galerij-grid">
        {cellen.map(({ foto, nummer, span, thumb, srcset, groot }) => (
          <figure class:list={['cel', `cel-${span}`]}>
            {foto.src && srcset ? (
              <a
                class="cel-link"
                href={groot}
                data-srcset={srcset}
                data-thumb={thumb}
                data-alt={foto.alt}
                data-onderschrift={foto.onderschrift ?? ''}
                data-nummer={nummer}
                aria-label={`Bekijk foto ${nummer} groot: ${foto.alt}`}
              >
                <Image src={foto.src} alt={foto.alt} width={800} height={Math.round((800 / foto.src.width) * foto.src.height)} loading="lazy" class="cel-beeld" style={foto.focus ? `object-position: ${foto.focus};` : undefined} />
                {foto.onderschrift && <span class="cel-overlay" aria-hidden="true">{foto.onderschrift}</span>}
              </a>
            ) : (
              <div class="cel-leeg" role="img" aria-label={foto.alt}>
                <p class="m-0 max-w-[24ch] text-klein text-ink-soft">Foto volgt</p>
              </div>
            )}
          </figure>
        ))}
      </div>

      <dialog id="galerij-dialoog" class="dialoog" aria-label="Fotoweergave">
        <figure class="dialoog-figuur m-0">
          <div class="dialoog-doek">
            <img id="dialoog-thumb" alt="" aria-hidden="true" />
            <img id="dialoog-beeld" alt="" sizes="92vw" />
            <div id="dialoog-spinner" class="dialoog-spinner" hidden aria-hidden="true" />
          </div>
          <p id="dialoog-fout" class="dialoog-fout" hidden>
            De foto kon niet laden.
            <button type="button" class="underline underline-offset-2" data-actie="opnieuw">Probeer opnieuw</button>
          </p>
          <figcaption class="mt-3 flex items-baseline gap-3 text-klein text-paper-dim">
            <span id="dialoog-nummer" class="font-display font-semibold text-paper" />
            <span id="dialoog-tekst" class="italic" />
            <span id="dialoog-teller" class="ms-auto tabular-nums" />
          </figcaption>
        </figure>
        <button type="button" class="dialoog-knop dialoog-sluit" data-actie="sluit" aria-label="Sluiten">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
        <button type="button" class="dialoog-knop dialoog-vorige" data-actie="vorige" aria-label="Vorige foto">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="dialoog-knop dialoog-volgende" data-actie="volgende" aria-label="Volgende foto">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </dialog>
    </Sectie>
  )
}

<script>
  // Lightbox als progressive enhancement; zie de component-docstring.
  const dialoog = document.getElementById('galerij-dialoog') as HTMLDialogElement | null;
  const grid = document.getElementById('galerij-grid');

  if (dialoog && grid && typeof dialoog.showModal === 'function') {
    const links = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.cel-link'));
    const beeld = document.getElementById('dialoog-beeld') as HTMLImageElement;
    const thumb = document.getElementById('dialoog-thumb') as HTMLImageElement;
    const spinner = document.getElementById('dialoog-spinner')!;
    const fout = document.getElementById('dialoog-fout')!;
    const nummerEl = document.getElementById('dialoog-nummer')!;
    const tekstEl = document.getElementById('dialoog-tekst')!;
    const tellerEl = document.getElementById('dialoog-teller')!;
    let huidig = 0;
    let bezig = false;
    let herkomst: HTMLElement | null = null;
    let wisselTeller = 0;
    const voorgeladen = new Map<number, HTMLImageElement>();

    const preload = (i: number) => {
      const n = (i + links.length) % links.length;
      if (voorgeladen.has(n)) return;
      const im = new Image();
      im.sizes = '92vw';
      im.srcset = links[n].dataset.srcset ?? '';
      voorgeladen.set(n, im);
    };

    const toon = async (i: number, richting = 0) => {
      if (bezig) return; // dubbele inputs tijdens een wissel negeren
      bezig = true;
      const wissel = ++wisselTeller;
      huidig = (i + links.length) % links.length;
      const link = links[huidig];

      nummerEl.textContent = `№ ${link.dataset.nummer}`;
      tekstEl.textContent = link.dataset.onderschrift ?? '';
      tellerEl.textContent = `${huidig + 1} / ${links.length}`;
      fout.hidden = true;

      // Instant: de thumbnail (al in cache door het grid), licht geblurd.
      thumb.src = link.dataset.thumb ?? '';
      thumb.style.opacity = '1';
      beeld.style.opacity = '0';
      const beweegOk = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (richting !== 0 && beweegOk) {
        beeld.parentElement!.animate(
          [{ transform: `translateX(${richting * 16}px)`, opacity: 0.6 }, { transform: 'none', opacity: 1 }],
          { duration: 180, easing: 'cubic-bezier(0.2, 0, 0, 1)' }
        );
      }

      // Spinner alleen als het decoderen echt lang duurt.
      const spinnerTimer = setTimeout(() => { spinner.hidden = false; }, 400);

      beeld.alt = link.dataset.alt ?? '';
      beeld.srcset = link.dataset.srcset ?? '';
      try {
        await beeld.decode();
        if (wissel === wisselTeller) {
          beeld.style.opacity = '1'; // cross-fade over de blur (150ms via CSS)
          thumb.style.opacity = '0';
        }
      } catch {
        if (wissel === wisselTeller) fout.hidden = false;
      } finally {
        clearTimeout(spinnerTimer);
        spinner.hidden = true;
        bezig = false;
      }

      // Buren voorladen; het venster schuift mee met de navigatie.
      preload(huidig + 1);
      preload(huidig - 1);
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        herkomst = link;
        dialoog.showModal();
        toon(i);
      });
    });

    dialoog.addEventListener('click', (e) => {
      const doel = e.target as HTMLElement;
      const actie = doel.closest<HTMLElement>('[data-actie]')?.dataset.actie;
      if (actie === 'sluit') dialoog.close();
      else if (actie === 'vorige') toon(huidig - 1, -1);
      else if (actie === 'volgende') toon(huidig + 1, 1);
      else if (actie === 'opnieuw') toon(huidig);
      // Klik op de achtergrond (het dialog-element zelf) sluit ook.
      else if (doel === dialoog) dialoog.close();
    });

    dialoog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        toon(huidig - 1, -1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        toon(huidig + 1, 1);
      }
    });

    // Swipe op touch; de knoppen blijven het alternatief.
    let beginX: number | null = null;
    dialoog.addEventListener('touchstart', (e) => {
      beginX = e.touches[0].clientX;
    }, { passive: true });
    dialoog.addEventListener('touchend', (e) => {
      if (beginX === null) return;
      const delta = e.changedTouches[0].clientX - beginX;
      if (Math.abs(delta) > 40) toon(huidig + (delta < 0 ? 1 : -1), delta < 0 ? 1 : -1);
      beginX = null;
    }, { passive: true });

    // Focus keert terug naar de aangeklikte cel.
    dialoog.addEventListener('close', () => {
      herkomst?.focus();
    });
  }
</script>

<style>
  /* Quilted grid: dense flow, cellen krijgen hun maat via spans; het grid
     zelf is de vormgeving — geen randen of schaduwen per foto. */
  /* Eigen papieren ondergrond boven de maatstreep. De spread bloedt links
     over de labelkolom heen en kruist daarmee de streep; zonder dit vlak
     schemert die tussen de foto's door in de gaps. */
  .grid-quilt {
    position: relative;
    z-index: var(--z-inhoud);
    background: var(--color-paper);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(6.5rem, 22vw, 10rem);
    grid-auto-flow: dense;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .grid-quilt {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(7rem, 11vw, 10.5rem);
      gap: 1rem;
    }
    /* Vanaf het marge-grid van Sectie claimt het grid de labelmarge terug
       voor volle boekbreedte. */
    .grid-quilt {
      margin-inline-start: -12.5rem;
    }
  }
  @media (min-width: 64rem) {
    .grid-quilt {
      margin-inline-start: -14.5rem;
    }
  }

  .cel {
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
    grid-column: span 1;
    grid-row: span 1;
  }
  .cel-groot {
    grid-column: span 2;
    grid-row: span 2;
  }
  .cel-staand {
    grid-row: span 2;
  }
  .cel-liggend {
    grid-column: span 2;
  }

  .cel-link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .cel :global(.cel-beeld) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cel-leeg {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    text-align: center;
    padding: 1rem;
  }

  /* Bijschrift als rustige overlay bij hover/focus. */
  .cel-overlay {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.5rem 0.75rem 0.6rem;
    font-size: var(--text-klein);
    color: var(--color-paper);
    background: linear-gradient(to top, rgb(35 26 28 / 0.65), transparent);
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .cel-link:hover .cel-overlay,
  .cel-link:focus-visible .cel-overlay {
    opacity: 1;
  }

  /* Micro-interactie: heel lichte scale binnen de cel. */
  @media (prefers-reduced-motion: no-preference) {
    .cel :global(.cel-beeld) {
      transition: transform 350ms cubic-bezier(0.2, 0, 0, 1);
    }
    .cel-link:hover :global(.cel-beeld),
    .cel-link:focus-visible :global(.cel-beeld) {
      transform: scale(1.02);
    }
  }

  /* Reveal per cel met een kleine stagger; uit bij reduced-motion. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .cel {
        /* Longhands: de minifier vouwt animation-timeline anders in de
           `animation:`-shorthand, en die vorm wijzen browsers af. */
        animation-name: cel-op;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
      .cel:nth-child(3n + 2) {
        animation-range: entry 8% entry 48%;
      }
      .cel:nth-child(3n) {
        animation-range: entry 16% entry 56%;
      }

      @media (min-width: 48rem) {
        .cel:nth-child(odd) .cel-link {
          animation-name: drift-op;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: cover 0% cover 100%;
        }
        .cel:nth-child(even) .cel-link {
          animation-name: drift-neer;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: cover 0% cover 100%;
        }
      }
    }
  }
  @keyframes cel-op {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* Micro-parallax: naburige cellen drijven tegengesteld, waardoor de spread
     bladert in plaats van staat. Alleen vanaf 48rem — op mobiel staat alles
     onder elkaar en zou het alleen maar onrustig zijn. */
  @keyframes drift-op {
    from { transform: translateY(var(--drift-galerij)); }
    to { transform: translateY(calc(-1 * var(--drift-galerij))); }
  }
  @keyframes drift-neer {
    from { transform: translateY(calc(-1 * var(--drift-galerij))); }
    to { transform: translateY(var(--drift-galerij)); }
  }

  /* Lightbox: donker bordeaux doek, beeld centraal, knoppen ruim (44px)
     en altijd zichtbaar. */
  .dialoog {
    border: none;
    padding: clamp(1rem, 4vw, 3rem);
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .dialoog[open] {
    display: flex;
  }
  .dialoog::backdrop {
    background: color-mix(in srgb, #4a1219 94%, black);
  }
  .dialoog-figuur {
    width: min(92vw, 70rem);
  }
  .dialoog-doek {
    position: relative;
    display: grid;
    place-items: center;
  }
  .dialoog-doek img {
    grid-area: 1 / 1;
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: 2px;
  }
  #dialoog-thumb {
    filter: blur(6px);
    transform: scale(1.01); /* verbergt de blur-rand */
  }
  #dialoog-beeld {
    transition: opacity 150ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    #dialoog-beeld {
      transition: none;
    }
  }
  .dialoog-spinner {
    position: absolute;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid rgb(250 246 243 / 0.3);
    border-top-color: var(--color-paper);
    animation: dialoog-draai 800ms linear infinite;
  }
  @keyframes dialoog-draai {
    to {
      transform: rotate(1turn);
    }
  }
  .dialoog-fout {
    margin-top: 0.75rem;
    color: var(--color-paper);
    font-size: var(--text-klein);
  }
  .dialoog-knop {
    position: fixed;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 2px;
    border: none;
    color: var(--color-paper);
    background: transparent;
    cursor: pointer;
  }
  .dialoog-knop:hover {
    background: color-mix(in srgb, var(--color-paper) 12%, transparent);
  }
  .dialoog-knop svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .dialoog-sluit {
    top: 0.75rem;
    right: 0.75rem;
  }
  .dialoog-vorige {
    left: 0.75rem;
    top: 50%;
    translate: 0 -50%;
  }
  .dialoog-volgende {
    right: 0.75rem;
    top: 50%;
    translate: 0 -50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dialoog[open] {
      animation: dialoog-op 240ms cubic-bezier(0.2, 0, 0, 1);
    }
    @keyframes dialoog-op {
      from {
        opacity: 0;
        transform: translateY(0.5rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
