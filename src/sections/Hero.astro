---
/**
 * De omslag van het programmaboekje, nu als eerste maat van een partituur:
 * een toon-op-toon notenbalk met solsleutel loopt achter de titel langs,
 * de footer sluit de pagina af met de eindstreep. De naam van de praktijk
 * staat groot in display; de ondertitel draagt de zoekintentie en zit mee
 * in de h1. Rechts het portretfoto-slot als rustige tonale outline.
 */
import Figuur from '../components/Figuur.astro';
import PartituurRegel from '../components/PartituurRegel.astro';
import Motief from '../components/ornaments/Motief.astro';
import Wordmark from '../components/Wordmark.astro';
import { hero } from '../data/copy';
import { site } from '../data/site';
// Portret uit de professionele fotoserie, 4:5 zoals het omslagontwerp vraagt.
import portret from '../assets/portret-christa.jpg';
---

<section class="relative overflow-hidden bg-bordeaux-deep" data-vlak="bordeaux">
  {/* De partituurregel: van rand tot rand, achter de titel */}
  <div class="parallax-balk absolute inset-x-0 top-[7rem] text-bordeaux md:top-[8.5rem]" aria-hidden="true">
    <PartituurRegel class="h-[clamp(7rem,19vw,13rem)]" />
  </div>

  {/* Het sier-motief van de omslag: klarinet met bloei, groot en toon-op-toon
      aan de rechteronderhoek, bloedend over de rand. Derde en achterste
      parallaxlaag, dus de traagste van de drie. Onder 640px weg: daar is de
      omslag al vol en zou hij achter de tekst door lopen. */}
  <div
    class="parallax-motief pointer-events-none absolute right-[-3rem] bottom-[-4rem] hidden w-80 text-paper opacity-[0.14] sm:block lg:right-[-1.5rem] lg:w-96"
    aria-hidden="true"
  >
    <Motief name="klarinet-bloei" class="w-full" />
  </div>

  <div class="relative mx-auto max-w-5xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
    <div class="grid items-end gap-10 md:grid-cols-[3fr_2fr] md:gap-16">
      <div>
        <h1 class="text-paper">
          <span class="block text-omslag">
            <Wordmark toon="paper" />
          </span>
          <span class="mt-3 block font-display text-subkop font-semibold text-paper-dim">
            {hero.subtitel}
          </span>
        </h1>
        <p class="mt-6 max-w-[46ch] text-paper-dim">
          {hero.intro}
        </p>
        <a
          href="#contact"
          class="mt-8 inline-block rounded-sm bg-paper px-6 py-3 font-bold text-bordeaux-deep transition-colors hover:bg-paper-dim"
        >
          {hero.cta}
        </a>
      </div>
      <Figuur
        src={portret}
        alt="Christa ten Berg met haar klarinet"
        breedte={640}
        hoogte={800}
        toon="bordeaux"
        class="max-w-xs md:max-w-none parallax-portret"
      />
    </div>
  </div>
</section>

<style>
  /* Gelaagde parallax op de omslag: de partituurregel loopt merkbaar achter
     op de scroll, het portret een fractie — twee lagen, klein gehouden
     (~10% van de scrollafstand) zodat niets overlapt of afsnijdt. Alleen
     transform, alleen waar scroll-driven animaties bestaan, en volledig
     uit bij reduced-motion. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .parallax-balk {
        /* Longhands: de minifier vouwt animation-timeline anders in de
           `animation:`-shorthand, en die vorm wijzen browsers af. */
        animation-name: balk-lag;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      section :global(.parallax-portret) {
        animation-name: portret-lag;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .parallax-motief {
        animation-name: motief-lag;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  /* Op mobiel is de scrollafstand korter en het scherm kleiner; de lagen
     reizen daar verder, anders voel je ze niet. */
  @keyframes balk-lag {
    from { transform: translateY(0); }
    to { transform: translateY(5.5rem); }
  }
  @keyframes portret-lag {
    from { transform: translateY(0); }
    to { transform: translateY(3rem); }
  }
  /* Het motief ligt het diepst, dus het loopt het verst achter. */
  @keyframes motief-lag {
    from { transform: translateY(0); }
    to { transform: translateY(6.5rem); }
  }
  @media (min-width: 48rem) {
    @keyframes balk-lag {
      from { transform: translateY(0); }
      to { transform: translateY(3.5rem); }
    }
    @keyframes portret-lag {
      from { transform: translateY(0); }
      to { transform: translateY(1.25rem); }
    }
    @keyframes motief-lag {
      from { transform: translateY(0); }
      to { transform: translateY(4.5rem); }
    }
  }
</style>
