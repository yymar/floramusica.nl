---
/**
 * De omslag van het programmaboekje, als eerste maat van een partituur:
 * een toon-op-toon notenbalk met solsleutel loopt achter de titel langs,
 * de footer sluit de pagina af met de eindstreep. De naam van de praktijk
 * staat groot in display; de ondertitel draagt de zoekintentie en zit mee
 * in de h1. Rechts het portret.
 *
 * Drie parallaxlagen (MOTION.md): achter de notenbalk met het sier-motief,
 * midden het tekstblok, voor het portret. Het portret loopt als enige tégen
 * de scroll in en hangt bovendien statisch over de bordeaux/papier-grens
 * heen. Die overhang is layout, geen animatie, en blijft dus ook staan bij
 * reduced motion — hij is wat de omslag en het binnenwerk aan elkaar knoopt.
 */
import Figuur from '../components/Figuur.astro';
import PartituurRegel from '../components/PartituurRegel.astro';
import Wordmark from '../components/Wordmark.astro';
import { hero } from '../data/copy';
// Portret uit de professionele fotoserie, 4:5 zoals het omslagontwerp vraagt.
import portret from '../assets/portret-christa.jpg';
// Het omslagmotief: Imkes handgetekende klarinet (Procreate), crème-variant
// op het bordeaux vlak. Vaste kleur, dus een <img> en geen inline SVG.
import klarinetImke from '../assets/imke-klarinet-creme.png';
---

<section class="relative bg-bordeaux-deep" data-vlak="bordeaux">
  {/* Eigen clip voor de achterste laag: de sectie zelf mag niet klippen,
      want het portret hoort er onderuit te steken. */}
  <div class="balk-clip" aria-hidden="true">
    <div class="parallax-balk">
      <PartituurRegel class="h-[clamp(7rem,19vw,13rem)]" />
    </div>
    <div class="parallax-motief">
      <img src={klarinetImke.src} alt="" width={klarinetImke.width} height={klarinetImke.height} loading="eager" />
    </div>
  </div>

  <div class="relative mx-auto max-w-5xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
    <div class="grid items-end gap-10 md:grid-cols-[3fr_2fr] md:gap-16">
      <div class="hero-tekst">
        <h1 class="text-paper">
          <span class="block text-omslag">
            <Wordmark toon="paper" />
          </span>
          <span class="mt-3 block font-display text-subkop font-semibold text-paper-dim">
            {hero.subtitel}
          </span>
        </h1>
        <p class="mt-6 max-w-[46ch] text-paper-dim">
          {hero.intro}
        </p>
        <a
          href="#contact"
          class="knop mt-8 inline-flex items-center gap-2 rounded-sm bg-paper px-6 py-3 font-bold text-bordeaux-deep transition-colors hover:bg-paper-dim"
        >
          {hero.cta}
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="parallax-portret">
        <Figuur
          src={portret}
          alt="Christa ten Berg met haar klarinet"
          breedte={640}
          hoogte={800}
          focus="50% 0%"
          toon="bordeaux"
          laden="eager"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // De notenbalk loopt de volle breedte door, ook door de rechtermarge waar
  // het klarinetmotief staat. Welke ornamenten daar precies achter vallen
  // hangt van de vensterbreedte af (de balk schaalt in viewBox-eenheden,
  // het motief in rem), dus dat wordt gemeten: elke tekening die de
  // tekenbox raakt gaat uit. De balklijnen zelf blijven gewoon doorlopen.
  const motief = document.querySelector('.parallax-motief');
  const ornamenten = document.querySelectorAll<SVGImageElement>('.partituur .orn');
  if (motief && ornamenten.length) {
    const pas = () => {
      const zichtbaar = getComputedStyle(motief).display !== 'none';
      const m = motief.getBoundingClientRect();
      for (const o of ornamenten) {
        const r = o.getBoundingClientRect();
        const raakt = zichtbaar && r.right > m.left - 12 && r.left < m.right + 12;
        o.style.opacity = raakt ? '0' : '';
      }
    };
    let timer = 0;
    addEventListener('resize', () => {
      clearTimeout(timer);
      timer = window.setTimeout(pas, 80);
    });
    pas();
  }
</script>

<style>
  /* `clip` en niet `hidden`: hidden maakt hiervan een scrollcontainer, en dan
     resolvet de view()-timeline van de lagen hierbinnen tegen dít blok — dat
     nooit scrolt — in plaats van tegen de viewport. De parallax staat dan
     stil terwijl alles er verder goed uitziet. Zelfde reden als bij
     .binnenwerk in global.css. */
  .balk-clip {
    position: absolute;
    inset: 0;
    overflow: clip;
    z-index: var(--z-achter);
  }
  .parallax-balk {
    position: absolute;
    inset-inline: 0;
    top: 7rem;
    color: var(--color-bordeaux);
  }
  /* Het motief staat in de rechtermarge van de omslag, los boven de
     onderrand: het instrument is volledig zichtbaar, inclusief de beker —
     de stengel (StengelBaan.astro) meet de bekerpunt en groeit daar verder.
     Mondstuk, klepwerk en bloem blijven altijd heel — daarom is de breedte
     precies de marge tussen het portret en de vensterrand, en niet meer:
     het portret houdt de rechterkolom van de container, wat daarnaast
     overblijft is (100vw − containerbreedte) / 2 plus de eigen padding.
     De hoogte hangt aan de hoogte van de omslag, niet aan de vensterbreedte.

     Onder 80rem is die marge te smal voor iets van deze schaal; dan is er
     geen plek waar het motief én heel is én niet achter het portret
     verdwijnt, dus staat het er niet. Liever weg dan half. */
  .parallax-motief {
    position: absolute;
    display: none;
    aspect-ratio: 323 / 900;
    /* Horizontaal gecentreerd in de marge tussen het portret en de
       vensterrand: de breedte is een deel van die marge (met een vaste
       bovengrens), en `right` verdeelt wat er overblijft gelijk. */
    --marge: calc((100vw - 64rem) / 2 + 1.5rem);
    --breedte: min(11rem, calc(var(--marge) * 0.78));
    width: var(--breedte);
    right: calc((var(--marge) - var(--breedte)) / 2);
    bottom: 2rem;
    /* Hoogtegrens voor korte vensters; object-fit hieronder houdt de
       tekening dan onvervormd en op de onderrand (waar de stengel aanhaakt). */
    max-height: 80%;
    /* Imkes lijntekening is crème op bordeaux; dunne lijnen, dus meer
       dekking dan het oude gevulde silhouet nodig had. */
    opacity: 0.85;
    pointer-events: none;
  }
  .parallax-motief img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  .hero-tekst {
    position: relative;
    z-index: var(--z-inhoud);
  }
  /* Het portret ligt vooraan én hangt over de grens met het binnenwerk. De
     negatieve marge moet ook de padding-bottom van de omslag overbruggen,
     anders slikt die de overhang op. */
  .parallax-portret {
    position: relative;
    z-index: var(--z-accent);
    max-width: 20rem;
    margin-bottom: calc(-1 * (var(--overlap-hero) + 4rem));
  }
  .parallax-portret :global(img) {
    box-shadow: var(--schaduw-overhang);
  }
  @media (min-width: 40rem) {
    .parallax-portret {
      margin-bottom: calc(-1 * (var(--overlap-hero) + 6rem));
    }
  }
  @media (min-width: 48rem) {
    .parallax-balk {
      top: 8.5rem;
    }
    .parallax-portret {
      max-width: none;
    }
  }
  @media (min-width: 80rem) {
    .parallax-motief {
      display: block;
    }
  }

  /* Micro-interactie: het pijltje loopt vooruit op hover en focus. */
  .knop .pijl {
    transition: transform var(--dur-m) var(--ease-organic);
  }
  .knop:hover .pijl,
  .knop:focus-visible .pijl {
    transform: translateX(4px);
  }

  /* De lagen, lineair aan de scroll gekoppeld (`exit`) terwijl de omslag het
     beeld uit schuift. Geen eigen duur of easing: de vinger van de bezoeker
     is de easing. Longhands, geen `animation:`-shorthand — die vouwt de
     minifier stuk zodra animation-timeline erbij staat. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Het motief beweegt niet mee: de stengel groeit uit de beker, en
         die aansluiting breekt zodra het motief verschuift. De balk
         erachter beweegt wel. */
      .parallax-balk {
        animation-name: balk-lag;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .hero-tekst {
        animation-name: tekst-lag;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .parallax-portret {
        animation-name: portret-lead;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  /* Op mobiel is de scrollafstand korter en het scherm kleiner; de lagen
     reizen daar verder, anders voel je ze niet. */
  @keyframes balk-lag {
    from { transform: translateY(0); }
    to { transform: translateY(5.5rem); }
  }
  @keyframes tekst-lag {
    from { transform: translateY(0); }
    to { transform: translateY(1.25rem); }
  }
  @keyframes portret-lead {
    from { transform: translateY(0); }
    to { transform: translateY(-1.25rem); }
  }
  @media (min-width: 48rem) {
    @keyframes balk-lag {
      from { transform: translateY(0); }
      to { transform: translateY(3.5rem); }
    }
    @keyframes tekst-lag {
      from { transform: translateY(0); }
      to { transform: translateY(0.9rem); }
    }
    @keyframes portret-lead {
      from { transform: translateY(0); }
      to { transform: translateY(-1.5rem); }
    }
  }
</style>
