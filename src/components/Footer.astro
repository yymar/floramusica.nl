---
/**
 * Footer met het notenbalkslot als bovenrand: de rechte notenbalk uit de
 * rest van de pagina, nu in zijn volle behandeling — vijf lijnen van rand
 * tot eindstreep, met Imkes handgetekende noten, bloemen en blad erop en
 * erlangs. De stengel uit Contact zwaait erop aan. Daaronder de zakelijke
 * gegevens. Regel: lege gegevens worden weggelaten, nooit als placeholder
 * getoond; zie CONTENT-TODO.md voor wat er nog mist.
 */
import Tekening from './ornaments/Tekening.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { footer } from '../data/copy';
import type { TekeningNaam } from './ornaments/tekeningen';

const gegevens = [site.email, site.telefoon, site.kvk].some(Boolean);

// De vijf lijnen liggen tussen 8 en 16 van 24 tegel-eenheden (StengelBaan
// meet dit slot als bronwaarheid); top-posities in % van de balkhoogte.
const lijnen = [33.333, 41.667, 50, 58.333, 66.667];

// De finale bezetting: nootkoppen op of rond de lijnen, bloemen en blad
// ertussen — dezelfde tuin als op de omslag, nu in bordeaux op papier.
// `links` is % van de balk, `hoogte`/`voet` in % van de balkhoogte.
type Plek = { naam: TekeningNaam; links: number; hoogte: number; voet: number };
// Zelfde terughoudende maat als de ornamenten elders op de pagina (loten,
// kop-takjes): de balk draagt, de tekeningen versieren — geen etalage.
const bezetting: Plek[] = [
  { naam: 'blad-1', links: 3, hoogte: 46, voet: 33 },
  { naam: 'noot-2a', links: 12, hoogte: 75, voet: 30 },
  { naam: 'noot-5a', links: 21, hoogte: 65, voet: 36 },
  { naam: 'bloem-1', links: 31, hoogte: 55, voet: 33 },
  { naam: 'noot-3a', links: 40, hoogte: 85, voet: 30 },
  { naam: 'noot-7a', links: 49, hoogte: 62, voet: 34 },
  { naam: 'blad-2', links: 60, hoogte: 49, voet: 33 },
  { naam: 'noot-6a', links: 67, hoogte: 65, voet: 36 },
  { naam: 'noot-1a', links: 77, hoogte: 75, voet: 26 },
  { naam: 'bloem-2', links: 84, hoogte: 59, voet: 33 },
  { naam: 'noot-4a', links: 92, hoogte: 81, voet: 30 },
];
---

<footer>
  {/* De finale. De pagina opende met een notenbalk en sluit hier af met
      dezelfde: vijf rechte lijnen met Imkes tekeningen erop, en de dubbele
      eindstreep als afsluiting.

      Vanaf 80rem (waar de stengel bestaat) begint de balk niet aan de
      vensterrand maar op de landing: de stengel komt verticaal uit Contact
      naar beneden, draait in de aanloop de bocht om en wordt de balk — één
      doorlopende tekening. Onder 80rem is er geen stengel en loopt de balk
      gewoon van de vensterrand af.

      De balk schrijft zichzelf van links naar rechts (MOTION.md), en de
      dubbele eindstreep valt als laatste in. Die staat waar de vijf lijnen
      eindigen en springt met de padding van .slot in van de vensterrand —
      anders leest hij als afsnijding in plaats van als afsluiting.

      Zonder scroll-driven animations of bij reduced motion staat het er
      gewoon, compleet. */}
  <div class="slot" aria-hidden="true">
    <div class="slot-balk">
      <div class="spoor">
        <div class="tegel">
          {lijnen.map((top) => <span class="balklijn" style={`top: ${top}%;`}></span>)}
          {
            bezetting.map((plek, i) => (
              <span
                class:list={['orn', i % 2 === 1 && 'orn-rust']}
                data-links={plek.links}
                style={`left: ${plek.links}%; height: ${plek.hoogte}%; bottom: ${plek.voet}%;`}
              >
                <Tekening naam={plek.naam} />
              </span>
            ))
          }
        </div>
      </div>
      <div class="eindstreep">
        <span class="streep-dun"></span>
        <span class="streep-dik"></span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="text-[1.25rem]">
        <Wordmark />
        <p class="mt-3 max-w-[36ch] text-klein text-ink-soft">
          {site.adres.straat}, {site.adres.plaats}<br />
          Muziekles in {site.regio}
        </p>
      </div>
      {
        gegevens && (
          <dl class="text-klein text-ink-soft">
            {site.email && (
              <div class="flex gap-3">
                <dt class="font-bold text-ink">E-mail</dt>
                <dd>
                  <a
                    href={`mailto:${site.email}`}
                    class="text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep"
                  >
                    {site.email}
                  </a>
                </dd>
              </div>
            )}
            {site.telefoon && (
              <div class="mt-2 flex gap-3 first:mt-0">
                <dt class="font-bold text-ink">Telefoon</dt>
                <dd>{site.telefoon}</dd>
              </div>
            )}
            {site.kvk && (
              <div class="mt-2 flex gap-3 first:mt-0">
                <dt class="font-bold text-ink">{footer.kvkLabel}</dt>
                <dd>{site.kvk}</dd>
              </div>
            )}
          </dl>
        )
      }
    </div>
    <p class="mt-10 text-klein text-ink-soft">{footer.colofon}</p>
  </div>
</footer>

<style>
  /* De balk loopt van de linkerrand af (zoals de omslag) maar eindigt met een
     inspringing, zodat de dubbele eindstreep leest als een bewuste afsluiting
     in plaats van als afsnijding tegen de vensterrand. */
  .slot {
    padding-right: 2rem;
  }
  @media (min-width: 48rem) {
    .slot {
      padding-right: 3rem;
    }
  }

  /* De hoogte van het slot is de bronwaarheid voor de stengel: StengelBaan
     meet hier de lijnafstand (hoogte/24 per eenheid, lijnen tussen 8 en 16)
     en de lijndikte. De verhouding blijft die van het oude lint, zodat de
     schaal van de hele stengel niet verspringt. */
  .slot-balk {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 1;
    color: var(--color-bordeaux);
  }
  @media (min-width: 48rem) {
    .slot-balk {
      aspect-ratio: 20 / 1;
    }
  }

  .spoor {
    position: absolute;
    inset: 0;
  }
  .tegel {
    position: absolute;
    inset: 0;
  }
  /* Vanaf 80rem (waar de stengel bestaat) beginnen de lijnen 16vw van de
     rand: de stengelbaan tekent daar zijn eigen kwartbocht die exact op de
     vijf balklijnen landt (StengelBaan.astro meet de linkerrand van deze
     .tegel). Exacte aansluiting, geen overlap: een dubbel getekende lijn
     wordt donkerder op 0.5 dekking. */
  @media (min-width: 80rem) {
    .tegel {
      left: 16vw;
    }
  }

  /* Lijndikte = 0.75 tegel-eenheid = dezelfde dikte als de stengel
     (eenheid x 0.5 x DIKTE 1.5 in StengelBaan). */
  .balklijn {
    position: absolute;
    left: 0;
    right: 0;
    height: 3.125%;
    translate: 0 -50%;
    background: currentColor;
    opacity: 0.5;
  }
  /* Boven 80rem tekent de stengel de vijf lijnen zélf door tot het einde
     (StengelBaan zet deze klasse): één verflaag, dus geen zichtbare naad
     op de landing. Zonder JavaScript blijft de klasse weg en staan deze
     CSS-lijnen er gewoon. */
  .slot-balk.balk-door-stengel .balklijn {
    display: none;
  }

  /* Imkes tekeningen liggen lichter dan de balk zelf, zoals in de rest van
     de pagina: de lijn draagt, het ornament versiert. De noten steken boven
     de balk uit; niets klipt ze af. */
  .orn {
    position: absolute;
    opacity: 0.4;
  }
  .orn :global(img) {
    height: 100%;
    width: auto;
  }
  /* Onder 48rem is de balk maar één maat breed: om de beurt een ornament
     overslaan, anders slibt de finale dicht. */
  @media (max-width: 47.99rem) {
    .orn-rust {
      display: none;
    }
  }

  /* Boven 80rem (waar de stengel de balklijnen zelf tekent) faden de
     tekeningen één voor één in zodra het front hun voet passeert — zelfde
     gebaar als de loten op de stengel. De klasse is-af komt uit
     StengelBaan. Zonder JavaScript bestaat balk-door-stengel niet en
     staan ze er gewoon. */
  .slot-balk.balk-door-stengel .orn {
    opacity: 0;
    transition: opacity 0.5s var(--ease-organic);
  }
  .slot-balk.balk-door-stengel .orn.is-af {
    opacity: 0.4;
  }
  @media (prefers-reduced-motion: reduce) {
    .slot-balk.balk-door-stengel .orn {
      transition: none;
    }
  }

  /* De vijf lijnen liggen tussen 8 en 16 van 24. */
  .eindstreep {
    position: absolute;
    right: 0;
    top: 33.333%;
    height: 33.333%;
    display: flex;
    align-items: stretch;
    gap: 3px;
    opacity: 0.7;
  }
  .streep-dun {
    width: 1px;
    background: currentColor;
  }
  .streep-dik {
    width: 4px;
    background: currentColor;
  }

  /* Alleen onder 80rem: daarboven stuurt StengelBaan.astro het schrijven
     van de balk, als voortzetting van hetzelfde reveal-front als de
     stengel — twee losse tijdlijnen liepen zichtbaar uit de pas. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 79.99rem) {
    @supports (animation-timeline: view()) {
      footer {
        view-timeline: --slot block;
      }
      /* De balk schrijft zichzelf van links naar rechts. clip-path en geen
         breedte: zo verspringt er niets binnenin. De inset laat boven en
         onder ruim los, want de noten steken boven de balk uit. */
      .spoor {
        animation-name: slot-schrijven;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 20% entry 75%;
      }
      /* De eindstreep is het laatste wat er staat — pas als de balk er ligt. */
      .eindstreep {
        animation-name: eindstreep-op;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 64% entry 88%;
      }
    }
  }

  @keyframes slot-schrijven {
    from { clip-path: inset(-100% 100% -20% 0); }
    to { clip-path: inset(-100% 0 -20% 0); }
  }
  @keyframes eindstreep-op {
    from { opacity: 0; }
    to { opacity: 0.7; }
  }
</style>
