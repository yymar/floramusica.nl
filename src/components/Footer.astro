---
/**
 * Footer met het notenbalk-motief als bovenrand: vijf bordeaux hairlines,
 * het enige decoratieve motief op de pagina. Daaronder de zakelijke
 * gegevens. Regel: lege gegevens worden weggelaten, nooit als
 * placeholder getoond; zie CONTENT-TODO.md voor wat er nog mist.
 */
import Ribbon from './ornaments/Ribbon.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { footer } from '../data/copy';

const gegevens = [site.email, site.telefoon, site.kvk].some(Boolean);
---

<footer>
  {/* De finale: het lint tekent zichzelf vlak boven de eindstreep terwijl je
      naar de voet van de pagina scrolt. Centerline-variant (200 bytes, één
      streek) — de enige plek op de pagina waar de draad zichzelf trekt.
      Zonder scroll-driven animations of bij reduced motion staat hij er
      gewoon, volledig getekend. */}
  {/* Notenbalk met eindstreep: de pagina opende met de sleutel (hero) en sluit hier de partituurregel af.
      Eén SVG met crispEdges, zodat lijndikte en -afstand op elke schermschaal gelijk blijven.

      Het slotakkoord (MOTION.md): de vijf lijnen schrijven zichzelf van links
      naar rechts terwijl de footer in beeld komt, de eindstreep valt daarna
      in. De timeline hangt aan de footer zelf (`view-timeline: --slot`) en
      niet aan de rects — een SVG-rect heeft geen eigen scrollpositie om aan
      te hangen. */}
  {/* De aanloop: het lint ligt strak op de notenbalk en tekent zichzelf op
      dezelfde --slot-timeline, vlak vóór de lijnen. Smal gehouden, want de
      streekdikte schaalt mee met de breedte en zou over de volle kolom
      zwaarder worden dan de eindstreep die hij aankondigt. */}
  <div class="slot" aria-hidden="true">
    <div class="flex justify-center">
      <Ribbon name="a" variant="centerline" draw class="w-80 text-bordeaux opacity-60" />
    </div>
    <svg width="100%" height="41" shape-rendering="crispEdges" class="slotbalk block text-bordeaux">
      {[0, 10, 20, 30, 40].map((y) => (
        <rect class="slotlijn" x="0" y={y} width="100%" height="1" fill="currentColor" />
      ))}
      <rect class="eindstreep" x="100%" transform="translate(-8 0)" y="0" width="1" height="41" fill="currentColor" />
      <rect class="eindstreep" x="100%" transform="translate(-4 0)" y="0" width="4" height="41" fill="currentColor" />
    </svg>
  </div>

  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="text-[1.25rem]">
        <Wordmark />
        <p class="mt-3 max-w-[36ch] text-klein text-ink-soft">
          {site.adres.straat}, {site.adres.plaats}<br />
          Muziekles in {site.regio}
        </p>
      </div>
      {
        gegevens && (
          <dl class="text-klein text-ink-soft">
            {site.email && (
              <div class="flex gap-3">
                <dt class="font-bold text-ink">E-mail</dt>
                <dd>
                  <a
                    href={`mailto:${site.email}`}
                    class="text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep"
                  >
                    {site.email}
                  </a>
                </dd>
              </div>
            )}
            {site.telefoon && (
              <div class="mt-2 flex gap-3 first:mt-0">
                <dt class="font-bold text-ink">Telefoon</dt>
                <dd>{site.telefoon}</dd>
              </div>
            )}
            {site.kvk && (
              <div class="mt-2 flex gap-3 first:mt-0">
                <dt class="font-bold text-ink">{footer.kvkLabel}</dt>
                <dd>{site.kvk}</dd>
              </div>
            )}
          </dl>
        )
      }
    </div>
    <p class="mt-10 text-klein text-ink-soft">{footer.colofon}</p>
  </div>
</footer>

<style>
  /* De balk loopt van de linkerrand af (zoals de omslag) maar eindigt met een
     inspringing, zodat de dubbele eindstreep leest als een bewuste afsluiting
     in plaats van als afsnijding tegen de vensterrand. */
  .slot {
    padding-right: 2rem;
  }
  @media (min-width: 48rem) {
    .slot {
      padding-right: 3rem;
    }
  }
  .slotlijn {
    opacity: 0.55;
    transform-origin: left;
  }
  .eindstreep {
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      footer {
        view-timeline: --slot block;
      }
      :global(.ornament-draw path) {
        animation-timeline: --slot;
        animation-range: entry 0% entry 30%;
      }
      .slotlijn {
        animation-name: lijn-groei;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 0% entry 45%;
      }
      .slotlijn:nth-child(2) { animation-range: entry 6% entry 51%; }
      .slotlijn:nth-child(3) { animation-range: entry 12% entry 57%; }
      .slotlijn:nth-child(4) { animation-range: entry 18% entry 63%; }
      .slotlijn:nth-child(5) { animation-range: entry 24% entry 69%; }
      /* De eindstreep is het laatste wat er staat — pas als de balk er ligt. */
      .eindstreep {
        animation-name: eindstreep-op;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 45% entry 80%;
      }
    }
  }

  @keyframes eindstreep-op {
    from { opacity: 0; }
    to { opacity: 0.7; }
  }
</style>
