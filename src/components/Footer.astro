---
/**
 * Footer met het notenbalkslot als bovenrand: het lint in zijn volle
 * behandeling — balk, noten en bladvlaggen — van rand tot eindstreep. De
 * stengel uit Contact zwaait erop aan. Daaronder de zakelijke gegevens. Regel: lege
 * gegevens worden weggelaten, nooit als placeholder getoond; zie
 * CONTENT-TODO.md voor wat er nog mist.
 */
import Wordmark from './Wordmark.astro';
import { lintGebruik } from './ornaments/svg';
import { site } from '../data/site';
import { footer } from '../data/copy';

const gegevens = [site.email, site.telefoon, site.kvk].some(Boolean);

// De slotbalk is een geketend lint dat van de linkervensterrand tot de
// eindstreep loopt: a→b, en vanaf 48rem twee keer. Elke tegel begint en
// eindigt met zijn vijf lijnen vlak op dezelfde hoogte, dus de keten sluit
// naadloos. Het tweede paar staat altijd in de HTML en wordt onder 48rem
// door CSS weggelaten — op die breedte zou het lint anders zo laag worden
// dat de balk dichtslibt.
const keten = (variant: 'quiet' | 'noten' | 'blad') =>
  lintGebruik('a', variant, 'tegel tegel-a') +
  lintGebruik('b', variant, 'tegel tegel-b') +
  lintGebruik('a', variant, 'tegel tegel-a') +
  lintGebruik('b', variant, 'tegel tegel-b');

// De aanloop: vijf kwartbochten die de stengel op de balk laten landen. De
// stengel verlaat Contact exact verticaal op x = 6% van de vensterbreedte
// (data/stengel.ts); hier draait elke lijn een eigen concentrische bocht en
// komt horizontaal uit op zijn balklijn (y 8–16 van 24), waarna de tegels
// beginnen. De x-eenheden zijn vw, de y-eenheden die van de tegel-viewBox:
// preserveAspectRatio="none" plakt beide assen op het element (16vw breed,
// slot-hoogte hoog), dus beide uiteinden sluiten op elke breedte exact aan.
// Buitenste stengelijn (links) → onderste balklijn, zoals in een echte bocht.
const rond = (n: number) => Math.round(n * 100) / 100;
const aanloop = [0, 1, 2, 3, 4].map((i) => {
  const x0 = 6 + (i - 2) * (5 / 12);
  const y = 16 - 2 * i;
  return `M${rond(x0)},0 C${rond(x0)},${rond(y * 0.55)} ${rond(16 - (16 - x0) * 0.55)},${rond(y)} 16,${rond(y)}`;
});
---

<footer>
  {/* De finale. De pagina opende met een notenbalk en sluit hier af met
      dezelfde, maar nu in de volle lintbehandeling: balk, noten en
      bladvlaggen, opgebouwd uit de drie lagen van het lintpakket zodat ze
      pixel-op-pixel over elkaar vallen.

      Vanaf 80rem (waar de stengel bestaat) begint de balk niet aan de
      vensterrand maar op de landing: de stengel komt verticaal uit Contact
      naar beneden, draait in de aanloop de bocht om en wordt de balk — één
      doorlopende tekening. Onder 80rem is er geen stengel en loopt de balk
      gewoon van de vensterrand af.

      De balk schrijft zichzelf van links naar rechts (MOTION.md), en de
      dubbele eindstreep valt als laatste in. Die staat op de rechterrand
      van de laatste tegel, waar de vijf lijnen vlak liggen, en springt met
      de padding van .slot in van de vensterrand — anders leest hij als
      afsnijding in plaats van als afsluiting.

      Zonder scroll-driven animations of bij reduced motion staat het er
      gewoon, compleet. */}
  <div class="slot" aria-hidden="true">
    <div class="slot-balk">
      <svg class="aanloop" viewBox="0 0 16 24" preserveAspectRatio="none">
        {aanloop.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
      </svg>
      <div class="spoor spoor-balk" set:html={keten('quiet')} />
      <div class="spoor spoor-noten" set:html={keten('noten')} />
      <div class="spoor spoor-blad" set:html={keten('blad')} />
      <div class="eindstreep">
        <span class="streep-dun"></span>
        <span class="streep-dik"></span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="text-[1.25rem]">
        <Wordmark />
        <p class="mt-3 max-w-[36ch] text-klein text-ink-soft">
          {site.adres.straat}, {site.adres.plaats}<br />
          Muziekles in {site.regio}
        </p>
      </div>
      {
        gegevens && (
          <dl class="text-klein text-ink-soft">
            {site.email && (
              <div class="flex gap-3">
                <dt class="font-bold text-ink">E-mail</dt>
                <dd>
                  <a
                    href={`mailto:${site.email}`}
                    class="text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep"
                  >
                    {site.email}
                  </a>
                </dd>
              </div>
            )}
            {site.telefoon && (
              <div class="mt-2 flex gap-3 first:mt-0">
                <dt class="font-bold text-ink">Telefoon</dt>
                <dd>{site.telefoon}</dd>
              </div>
            )}
            {site.kvk && (
              <div class="mt-2 flex gap-3 first:mt-0">
                <dt class="font-bold text-ink">{footer.kvkLabel}</dt>
                <dd>{site.kvk}</dd>
              </div>
            )}
          </dl>
        )
      }
    </div>
    <p class="mt-10 text-klein text-ink-soft">{footer.colofon}</p>
  </div>
</footer>

<style>
  /* De balk loopt van de linkerrand af (zoals de omslag) maar eindigt met een
     inspringing, zodat de dubbele eindstreep leest als een bewuste afsluiting
     in plaats van als afsnijding tegen de vensterrand. */
  .slot {
    padding-right: 2rem;
  }
  @media (min-width: 48rem) {
    .slot {
      padding-right: 3rem;
    }
  }

  /* Eén a→b-paar op smalle schermen, twee vanaf 48rem. De verhouding zet de
     hoogte: a is 6× en b 4× zo breed als hoog, dus een paar is precies 10×.
     Daardoor passen de paren exact in de breedte en valt de rechterrand op
     een tegelrand — de enige plek waar de golf vlak ligt en de eindstreep de
     vijf lijnen haaks kruist. */
  .slot-balk {
    --paren: 1;
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 1;
    color: var(--color-bordeaux);
  }
  @media (min-width: 48rem) {
    .slot-balk {
      --paren: 2;
      aspect-ratio: 20 / 1;
    }
  }

  .spoor {
    position: absolute;
    inset: 0;
    display: flex;
  }
  .spoor-balk {
    opacity: 0.5;
  }
  /* Noten en bladvlaggen liggen lichter dan de balk zelf, zoals in de rest
     van de pagina: de lijn draagt, het ornament versiert. */
  .spoor-noten,
  .spoor-blad {
    opacity: 0.32;
  }
  /* Breedtes uitgerekend, niet uit de viewBox afgeleid: dan telt de rij
     gegarandeerd op tot 100% en blijft er geen subpixelnaad staan. */
  .slot-balk :global(.tegel) {
    height: 100%;
    flex: none;
    /* De noten steken boven en onder de viewBox van het lint uit; zonder dit
       snijdt de tegel zijn eigen vlaggen af. */
    overflow: visible;
  }
  /* Elke tegel rendert een pixel breder dan hij opschuift, zodat de
     naden overlappen. Zonder dat halveert de antialiasing de dekking van de
     lijn precies op de tegelrand en staat er een lichte streep in de balk. */
  .slot-balk :global(.tegel-a) {
    width: calc(60% / var(--paren) + 1px);
    margin-right: -1px;
  }
  .slot-balk :global(.tegel-b) {
    width: calc(40% / var(--paren) + 1px);
    margin-right: -1px;
  }
  @media (max-width: 47.99rem) {
    .spoor :global(.tegel:nth-child(n + 3)) {
      display: none;
    }
  }

  /* De aanloop bestaat alleen waar de stengel bestaat (≥80rem): daar
     schuiven de tegels 16vw op en landt de stengel via de bocht op de balk.
     De −1px op de marge overlapt de naad, zoals tussen de tegels onderling. */
  .aanloop {
    display: none;
  }
  .aanloop path {
    fill: none;
    stroke: currentColor;
    /* Zelfde dikte als de stengel (Stengel.astro): de bocht is het
       verbindingsstuk en mag aan geen van beide kanten verspringen. */
    stroke-width: calc((100vw - 48px) / 960);
  }
  @media (min-width: 80rem) {
    .aanloop {
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      width: 16vw;
      height: 100%;
      overflow: visible;
      opacity: 0.5;
    }
    .slot-balk :global(.tegel-a) {
      width: calc((100% - 16vw) * 0.3 + 1px);
    }
    .slot-balk :global(.tegel-b) {
      width: calc((100% - 16vw) * 0.2 + 1px);
    }
    .spoor :global(.tegel:first-child) {
      margin-left: calc(16vw - 1px);
    }
  }


  /* De vijf lijnen liggen op een tegelrand tussen 8 en 16 van 24. */
  .eindstreep {
    position: absolute;
    right: 0;
    top: 33.333%;
    height: 33.333%;
    display: flex;
    align-items: stretch;
    gap: 3px;
    opacity: 0.7;
  }
  .streep-dun {
    width: 1px;
    background: currentColor;
  }
  .streep-dik {
    width: 4px;
    background: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      footer {
        view-timeline: --slot block;
      }
      /* Eerst draait de stengel de bocht om (wipe van links naar rechts —
         de padrichting; geen dash-draw, zie Stengel.astro), dan schrijft de
         balk zichzelf. clip-path en geen breedte: zo verspringt er niets
         binnenin. */
      .aanloop {
        animation-name: slot-schrijven;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 0% entry 25%;
      }
      .spoor {
        animation-name: slot-schrijven;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 20% entry 75%;
      }
      /* De eindstreep is het laatste wat er staat — pas als de balk er ligt. */
      .eindstreep {
        animation-name: eindstreep-op;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --slot;
        animation-range: entry 64% entry 88%;
      }
    }
  }

  @keyframes slot-schrijven {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes eindstreep-op {
    from { opacity: 0; }
    to { opacity: 0.7; }
  }
</style>
