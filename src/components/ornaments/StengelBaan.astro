---
/**
 * De stengel als één object: één globaal pad van de beker in de omslag tot
 * op de liggende footerbalk, runtime gegenereerd in pixels.
 *
 * Waarom runtime en niet build-time: de secties hebben variabele hoogtes,
 * en een écht doorlopend lint — constante breedte (normaal-offsets, geen
 * x-offsets die op diagonalen versmallen), gecontroleerde bochtstralen, één
 * monotone reveal-parameter — bestaat alleen in gemeten pixelruimte. De
 * per-sectie benadering met genormaliseerde viewBoxen kon secties laten
 * verschillen; dit kan dat structureel niet meer.
 *
 * De reveal is een pure functie van scrollpositie, elk frame opnieuw
 * (ook bij End, ankerlinks en herladen): alles vóór het front is getekend,
 * alles erna niet — één front, in padvolgorde. De tip is organisch: de
 * middelste lijn loopt iets voor, de buitenste iets achter.
 *
 * Zonder JavaScript is er geen stengel (pure decoratie); bij reduced motion
 * staat hij er volledig en statisch. Onder 80rem bestaat hij niet: daar
 * zijn de marges er niet, en de bloem ook niet.
 */
import { route, loten, SCHAAL, DIKTE, DEKKING, TAPER_PX } from '../../data/stengel';
import Sprig from './Sprig.astro';
---

<div class="stengelbaan" aria-hidden="true" data-dekking={DEKKING}>
  <svg></svg>
  {
    loten.map((loot) => (
      <span
        class="loot"
        data-deel={loot.deel}
        data-y={loot.y}
        data-kant={loot.kant}
        style={`--draai: ${loot.draai}deg;`}
      >
        <Sprig name={loot.naam} class="w-full" />
      </span>
    ))
  }
</div>

<script>
  import { route, SCHAAL, DIKTE, TAPER_PX } from '../../data/stengel';

  type P = { x: number; y: number };

  const baan = document.querySelector<HTMLElement>('.stengelbaan');
  const svg = baan?.querySelector('svg');

  if (baan && svg) {
    const NS = 'http://www.w3.org/2000/svg';
    const rustig = matchMedia('(prefers-reduced-motion: reduce)');
    const breed = matchMedia('(min-width: 80rem)');

    let samples: P[] = [];
    let cum: number[] = [];
    let yMono: number[] = [];
    let paden: { el: SVGPathElement; punt: string[]; cumL: number[]; lengte: number; dVol: string }[] = [];
    let lootEls: { el: HTMLElement; s: number }[] = [];
    let totaal = 0;
    let balkY = 0;
    const sporen = document.querySelectorAll<HTMLElement>('.slot-balk .spoor');
    const eindstreep = document.querySelector<HTMLElement>('.eindstreep');

    /** Catmull-Rom door de ankers, bemonsterd; tangenten centraal verschil. */
    const bemonster = (ankers: P[], perStuk = 22): P[] => {
      const t = ankers.map((_, i) => {
        const a = ankers[Math.max(0, i - 1)];
        const b = ankers[Math.min(ankers.length - 1, i + 1)];
        return { x: (b.x - a.x) / 2, y: (b.y - a.y) / 2 };
      });
      const uit: P[] = [];
      for (let i = 0; i < ankers.length - 1; i++) {
        const p0 = ankers[i], p3 = ankers[i + 1];
        const c1 = { x: p0.x + t[i].x / 3, y: p0.y + t[i].y / 3 };
        const c2 = { x: p3.x - t[i + 1].x / 3, y: p3.y - t[i + 1].y / 3 };
        for (let k = i === 0 ? 0 : 1; k <= perStuk; k++) {
          const u = k / perStuk, w = 1 - u;
          uit.push({
            x: w * w * w * p0.x + 3 * w * w * u * c1.x + 3 * w * u * u * c2.x + u * u * u * p3.x,
            y: w * w * w * p0.y + 3 * w * w * u * c1.y + 3 * w * u * u * c2.y + u * u * u * p3.y,
          });
        }
      }
      return uit;
    };

    const bouw = () => {
      svg.replaceChildren();
      paden = [];
      lootEls = [];
      if (!breed.matches) {
        schrijfBalk(1); // onder 80rem schrijft de footer zichzelf via CSS
        return;
      }

      const baanRect = baan.getBoundingClientRect();
      const slot = document.querySelector('.slot-balk');
      const tegel = document.querySelector<HTMLElement>('.slot-balk .tegel');
      if (!slot || !tegel) return;
      const slotRect = slot.getBoundingClientRect();
      const vw = baanRect.width;

      // De footerbalk is de bronwaarheid: lijnafstand en dikte gemeten.
      const eenheid = slotRect.height / 24; // 1 tegel-eenheid in px
      const gapBalk = eenheid * 2;
      const dikte = eenheid * 0.5 * DIKTE;
      const balkMidden = slotRect.top - baanRect.top + eenheid * 12;
      const tegelStart = tegel.getBoundingClientRect().left - baanRect.left;

      // Ankers naar pixels (x: % venster, y: % sectie, relatief aan de baan).
      // Rechtermarge-ankers worden geklemd tussen contentkolom + 70px en de
      // vensterrand: op 1280 is de marge te smal voor een vast percentage,
      // op 2560 te breed.
      const content = document.querySelector('#over > div')!.getBoundingClientRect();
      const ankers: P[] = route.map((a) => {
        const sectie = document.getElementById(a.deel)!;
        const r = sectie.getBoundingClientRect();
        let x = (a.x / 100) * vw;
        if (a.klem === 'rechts') x = Math.min(vw - 60, Math.max(x, content.right - baanRect.left + 70));
        return { x, y: r.top - baanRect.top + (a.y / 100) * r.height };
      });
      // Het begin: de stengel groeit uit de beker van het omslagmotief.
      // De bekerpunt gemeten (het instrument staat rond 52% van de
      // motief-viewBox), iets erbinnen zodat de lijnen erachter vandaan
      // komen; de baan mag boven zijn eigen vak uitsteken (overflow
      // visible, alleen horizontaal geclipt).
      const motief = document.querySelector('.parallax-motief');
      if (motief) {
        const m = motief.getBoundingClientRect();
        if (m.height > 0) {
          // Onder de volledige tekenbox, plus de halve linthoogte: het pad
          // vertrekt hier vrijwel horizontaal, dus de buitenste van de vijf
          // lijnen ligt ~2 lijnafstanden bóven het middenpad. Zonder die
          // marge snijden ze de bekerrand en de rank van de tekening aan.
          // De extra ~34px is voor de zwaai naar rechts direct na de start:
          // die loopt onder de bloem rechtsonder langs, en de bovenste lijn
          // stijgt daar licht boven het middenpad uit.
          const halfLint = gapBalk * SCHAAL * 2;
          ankers.unshift({ x: m.left - baanRect.left + m.width * 0.52, y: m.bottom - baanRect.top + halfLint + 34 });
        }
      }
      // De landing: verticaal aanlopen boven de balk, dan de kwartbocht.
      // De hulpankers moeten ónder het laatste route-anker blijven: een
      // anker dat hoger uitkomt laat y even teruglopen, de raaklijn
      // omklappen en de vijf offsets een lus draaien — de knoop die op
      // brede schermen zichtbaar werd.
      const landX = 0.06 * vw;
      const laatste = ankers[ankers.length - 1];
      const bocht = Math.min(150, Math.max(80, balkMidden - laatste.y - 160));
      const tussenY = Math.max(laatste.y + 50, balkMidden - bocht - 110);
      ankers.push({ x: landX, y: tussenY }, { x: landX, y: Math.max(tussenY + 40, balkMidden - bocht) });

      const midden = bemonster(ankers);
      // Kwartbocht (ribbon-c-model): verticaal → horizontaal, apart bemonsterd
      // zodat de eindtangent exact vlak is en de vijf lijnen exact op de
      // balklijnen landen.
      const b0 = midden[midden.length - 1];
      // De bocht eindigt 18px vóór de tegels; daarna volgt een exact
      // horizontaal stukje dat 1px de eerste tegel in doorloopt (zoals de
      // tegels onderling overlappen tegen antialiasing-naden). Zo staan
      // de laatste normalen precies verticaal (geen minieme rotatie van de
      // vijf uiteinden op de naad) en zit het lint zonder spleet aan de
      // tegel vast.
      const eindX = tegelStart - 18;
      for (let k = 1; k <= 26; k++) {
        const u = k / 26, w = 1 - u;
        const c1 = { x: landX, y: b0.y + (balkMidden - b0.y) * 0.55 };
        const c2 = { x: eindX - (eindX - landX) * 0.45, y: balkMidden };
        midden.push({
          x: w * w * w * b0.x + 3 * w * w * u * c1.x + 3 * w * u * u * c2.x + u * u * u * eindX,
          y: w * w * w * b0.y + 3 * w * w * u * c1.y + 3 * w * u * u * c2.y + u * u * u * balkMidden,
        });
      }
      midden.push({ x: tegelStart - 8, y: balkMidden }, { x: tegelStart + 1, y: balkMidden });

      samples = midden;
      cum = [0];
      for (let i = 1; i < samples.length; i++) {
        cum.push(cum[i - 1] + Math.hypot(samples[i].x - samples[i - 1].x, samples[i].y - samples[i - 1].y));
      }
      totaal = cum[cum.length - 1];
      // Lopend maximum van y: het reveal-front zoekt hierin, zodat een
      // minieme lokale terugloop in y de volgorde nooit kan breken.
      yMono = samples.map((p) => p.y);
      for (let i = 1; i < yMono.length; i++) yMono[i] = Math.max(yMono[i - 1], yMono[i]);
      balkY = balkMidden;

      // Normalen (centraal verschil) en de taper: constante breedte op de
      // hele route, alleen de laatste TAPER_PX naar footermaat (schaal 1).
      const spreiding = (i: number) => {
        // De laatste 24px (het vlakke stukje op de naad) zijn al exact
        // balkmaat; de taper rekent tot daar.
        const rest = Math.max(0, totaal - cum[i] - 24);
        const s = rest >= TAPER_PX ? SCHAAL : 1 + (SCHAAL - 1) * (rest / TAPER_PX);
        // Start-taper: het lint ontkiemt smal uit de beker en groeit over
        // de eerste ~260px naar volle breedte. Organisch, én het houdt de
        // binnenste lijnen uit elkaar in de krappe bocht direct na de
        // start (daar kruisten ze anders tot een strik-artefact).
        const groei = Math.min(1, 0.35 + 0.65 * (cum[i] / 260));
        return gapBalk * s * groei;
      };

      svg.setAttribute('width', String(vw));
      svg.setAttribute('height', String(Math.ceil(balkMidden + 40)));
      svg.setAttribute('viewBox', `0 0 ${vw} ${Math.ceil(balkMidden + 40)}`);

      const rond = (n: number) => Math.round(n * 10) / 10;
      for (let lijn = -2; lijn <= 2; lijn++) {
        // Punten en cumulatieve lengte per lijn: de reveal knipt hieruit
        // per frame het zichtbare stuk (zie teken()) — geen dasharray.
        // WebKit's dasher ontspoort op dit pad (honderden segmenten, dash
        // in padlengte-orde): alles voorbij het eerste dash-uiteinde werd
        // massief getekend, in elke variant (px, pathLength, CSS).
        const punt: string[] = [];
        const cumL: number[] = [];
        let lengte = 0;
        let vx = 0, vy = 0;
        for (let i = 0; i < samples.length; i++) {
          const a = samples[Math.max(0, i - 1)];
          const b = samples[Math.min(samples.length - 1, i + 1)];
          const dx = b.x - a.x, dy = b.y - a.y;
          const len = Math.hypot(dx, dy) || 1;
          const nx = -dy / len, ny = dx / len;
          const off = lijn * spreiding(i);
          const x = samples[i].x + nx * off, y = samples[i].y + ny * off;
          if (i > 0) lengte += Math.hypot(x - vx, y - vy);
          punt.push(`${rond(x)},${rond(y)}`);
          cumL.push(lengte);
          vx = x; vy = y;
        }
        const dVol = `M${punt[0]}L${punt.slice(1).join('L')}`;
        const pad = document.createElementNS(NS, 'path');
        pad.setAttribute('d', dVol);
        pad.setAttribute('fill', 'none');
        pad.setAttribute('stroke', 'currentColor');
        pad.setAttribute('stroke-width', String(Math.round(dikte * 100) / 100));
        paden.push({ el: pad, punt, cumL, lengte, dVol });
        svg.appendChild(pad);
      }

      // Loten op het pad: x volgt uit het pad op de gevraagde sectiehoogte.
      baan.querySelectorAll<HTMLElement>('.loot').forEach((el) => {
        const sectie = document.getElementById(el.dataset.deel!)!;
        const r = sectie.getBoundingClientRect();
        const doelY = r.top - baanRect.top + (Number(el.dataset.y) / 100) * r.height;
        let i = samples.findIndex((p) => p.y >= doelY);
        if (i < 0) i = samples.length - 1;
        const kant = Number(el.dataset.kant);
        const lootX = Math.min(vw - 26, samples[i].x + kant * (2 * spreiding(i) + 26));
        el.style.left = `${rond(lootX)}px`;
        el.style.top = `${rond(doelY)}px`;
        lootEls.push({ el, s: cum[i] });
      });

      teken();
    };

    /**
     * Het reveal-front: één monotone functie van scrollpositie. De tip ligt
     * op 60% van de viewport; tegen de paginavoet schuift hij mee omlaag
     * zodat het pad op maximale scroll gegarandeerd af is.
     */
    const front = () => {
      const vh = innerHeight;
      const baanTop = baan.getBoundingClientRect().top + scrollY;
      const docH = document.documentElement.scrollHeight;
      const eind = Math.max(0, docH - vh);
      // Bij paginalading staat er niets: het front begint exact vóór het
      // padbegin (de bekerpunt kan boven de 60%-lijn liggen) en loopt over
      // de eerste 400px scroll soepel naar de normale 60%-lijn — de
      // klarinet begint pas te spelen als je scrollt.
      const startRem = Math.max(0, 0.6 * vh - baanTop - (samples[0].y - 4));
      const inloop = Math.max(0, 1 - scrollY / 400);
      // Op maximale scroll moet het front voorbij de eindstreep zijn; het
      // tekort hangt van de vensterhoogte af (op hoge vensters is 40vh meer
      // dan de hele footer) en loopt over de laatste 300px scroll in.
      const doel = baanTop + balkY + 180;
      const tekort = Math.max(0, doel - (eind + 0.6 * vh));
      const aandeel = eind > 0 ? Math.max(0, Math.min(1, (scrollY - (eind - 300)) / 300)) : 1;
      return scrollY + 0.6 * vh - startRem * inloop + tekort * aandeel - baanTop;
    };

    const LEAD = [0, 14, 26, 14, 0]; // organische tip: middellijn voorop

    /** Voortzetting van hetzelfde front: de balk schrijft zichzelf pas
        nadat de stengel geland is, over de laatste ~200px fronttravel. */
    const schrijfBalk = (fractie: number) => {
      for (const sp of sporen) {
        sp.style.clipPath = fractie < 1 ? `inset(0 ${Math.round((1 - fractie) * 1000) / 10}% 0 0)` : '';
      }
      if (eindstreep) {
        eindstreep.style.opacity =
          fractie >= 1 ? '' : String(Math.round(Math.max(0, (fractie - 0.8) / 0.2) * 0.7 * 100) / 100);
      }
    };

    /** Het zichtbare stuk van één lijn als padstring: prefix tot aan de
        gevraagde lengte, met een geïnterpoleerd eindpunt op de maat. */
    const knip = (p: (typeof paden)[number], z: number) => {
      if (z <= 0) return `M${p.punt[0]}`;
      if (z >= p.lengte) return p.dVol;
      let lo = 0, hi = p.cumL.length - 1;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (p.cumL[mid] <= z) lo = mid;
        else hi = mid - 1;
      }
      const d = `M${p.punt[0]}${lo > 0 ? `L${p.punt.slice(1, lo + 1).join('L')}` : ''}`;
      const rest = p.cumL[lo + 1] - p.cumL[lo];
      const t = rest > 0 ? (z - p.cumL[lo]) / rest : 0;
      const [ax, ay] = p.punt[lo].split(',').map(Number);
      const [bx, by] = p.punt[lo + 1].split(',').map(Number);
      return `${d}L${Math.round((ax + (bx - ax) * t) * 10) / 10},${Math.round((ay + (by - ay) * t) * 10) / 10}`;
    };

    const teken = () => {
      if (!paden.length) return;
      if (rustig.matches) {
        for (const p of paden) p.el.setAttribute('d', p.dVol);
        for (const l of lootEls) l.el.classList.add('is-af');
        schrijfBalk(1);
        return;
      }
      const fy = front();
      // Laatste sample vóór het front (yMono is monotoon niet-dalend).
      let lo = 0, hi = samples.length - 1;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (yMono[mid] <= fy) lo = mid;
        else hi = mid - 1;
      }
      const s = yMono[0] > fy ? 0 : cum[lo];
      // De organische voorsprong van de middellijn groeit mee met het
      // begin, anders steken er op de eerste pixels al puntjes uit.
      const voorsprong = Math.min(1, s / 120);
      paden.forEach((p, i) => {
        const zichtbaar = Math.max(0, Math.min(p.lengte, (s / totaal) * p.lengte + LEAD[i] * voorsprong));
        p.el.setAttribute('d', knip(p, zichtbaar));
      });
      for (const l of lootEls) l.el.classList.toggle('is-af', l.s <= s);
      // Eén doorlopend front: eerst de stengel tot en met de landing, dan
      // de balk van links naar rechts, als voortzetting van dezelfde t.
      schrijfBalk(s >= totaal - 1 ? Math.min(1, Math.max(0, (fy - balkY) / 160)) : 0);
    };

    let vlag = false;
    const plan = () => {
      if (vlag) return;
      vlag = true;
      requestAnimationFrame(() => { vlag = false; teken(); });
    };

    addEventListener('scroll', plan, { passive: true });
    rustig.addEventListener('change', teken);
    breed.addEventListener('change', bouw);
    // Herbouwen als de layout zet (fonts, late afbeeldingen, resize).
    let herbouwTimer = 0;
    const herbouw = () => { clearTimeout(herbouwTimer); herbouwTimer = window.setTimeout(bouw, 120); };
    new ResizeObserver(herbouw).observe(baan);
    addEventListener('resize', herbouw);
    bouw();
  }
</script>

<style>
  .stengelbaan {
    position: absolute;
    inset: 0;
    display: none;
    color: var(--color-bordeaux);
    pointer-events: none;
  }
  @media (min-width: 80rem) {
    .stengelbaan {
      display: block;
    }
  }
  .stengelbaan svg {
    display: block;
    overflow: visible;
    opacity: 0.5; /* DEKKING: de footerbalk zelf staat ook op 0.5 */
  }
  .loot {
    position: absolute;
    width: 2.5rem;
    translate: -50% -50%;
    rotate: var(--draai);
    opacity: 0;
    transition: opacity 0.5s var(--ease-organic);
  }
  .loot.is-af {
    opacity: 0.4;
  }
  @media (prefers-reduced-motion: reduce) {
    .loot {
      opacity: 0.4;
      transition: none;
    }
  }
</style>
