---
/**
 * Het lint: de doorlopende draad van notenbalk, noten en blad. Drie vormen —
 * `a` en `b` liggen breed (144×24 en 96×24), `c` staat rechtop (60×76).
 *
 * Varianten — zie MANIFEST.md:
 *   full       → voorgrond, vol detail
 *   quiet      → achtergrondwatermerk, uitsluitend op 8–15% dekking
 *   centerline → één streek van een paar honderd bytes, alleen bedoeld voor
 *                de draw-animatie hieronder
 *
 * Geef altijd een breedte mee (`class="w-6"`, `class="w-full"`): het
 * component zet alleen `h-auto`, zodat de viewBox de verhouding levert en
 * de layout niet verspringt.
 *
 * `draw` zet de scroll-gestuurde draw-animatie aan: het lint tekent zichzelf
 * terwijl het in beeld komt. Vereist `variant="centerline"` (een gevuld pad
 * valt niet te tekenen) en draait alleen waar scroll-driven animations
 * bestaan; bij `prefers-reduced-motion: reduce` staat het lint er meteen
 * volledig. De CSS staat in `src/styles/global.css` onder `.ornament-draw`,
 * want scoped styles bereiken deze ingezette markup niet.
 */
import { lintSvg, type LintNaam } from './svg';

interface Props {
  name: LintNaam;
  variant?: 'full' | 'quiet' | 'centerline';
  draw?: boolean;
  class?: string;
}
const { name, variant = 'full', draw = false, class: className = '' } = Astro.props;

if (draw && variant !== 'centerline') {
  throw new Error(`Ribbon "${name}": draw werkt alleen op variant="centerline", niet op "${variant}".`);
}

const svg = lintSvg(name, variant, `block h-auto ${draw ? 'ornament-draw ' : ''}${className}`, draw);
---

<Fragment set:html={svg} />
