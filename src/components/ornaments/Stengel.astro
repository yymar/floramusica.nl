---
/**
 * Eén sectie-segment van de stengel (zie lib/stengel.ts en data/stengel.ts):
 * de vijflijnige notenbalk die als slingerpad door de pagina golft, van de
 * bloem in de omslag naar de liggende balk in de footer.
 *
 * Achtergrondlaag: absoluut, inset 0, z-index -1, aria-hidden. De sectie
 * eromheen moet een stapelcontext zijn (`<Sectie band>`). Haal het segment
 * weg en er verschuift niets.
 *
 * Alleen vanaf 80rem: daaronder bestaan de marges niet waar de stengel
 * doorheen slingert (het galerijgrid raakt daar bijna de vensterrand), en
 * verdwijnt ook de bloem waar hij uit groeit.
 *
 * Het segment tekent zichzelf van boven naar beneden terwijl de sectie in
 * beeld komt, de vijf lijnen een fractie na elkaar. Bij reduced motion of
 * zonder scroll-driven animations staat hij er gewoon, compleet.
 */
import { stengelPaden } from '../../lib/stengel';
import { stengel, type StengelDeel } from '../../data/stengel';
import Sprig from './Sprig.astro';

interface Props {
  deel: StengelDeel;
  /** Dekking van de lijnen; 0.1 onder tekstzones, hoger alleen op leeg vlak. */
  dekking?: number;
  class?: string;
}
const { deel, dekking = 0.1, class: className } = Astro.props;
const segment = stengel[deel];
const paden = stengelPaden(segment);
---

<div class:list={['stengel', className]} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" style={`opacity: ${dekking};`}>
    {paden.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  </svg>
  {
    segment.loten?.map((loot) => (
      <span class="loot" style={`left: ${loot.x}%; top: ${loot.y}%; --draai: ${loot.draai ?? 0}deg;`}>
        <Sprig name={loot.naam} class="w-full" />
      </span>
    ))
  }
</div>

<style>
  .stengel {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: none;
    color: var(--color-bordeaux);
    pointer-events: none;
  }
  @media (min-width: 80rem) {
    .stengel {
      display: block;
    }
  }
  .stengel svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .stengel path {
    fill: none;
    stroke: currentColor;
    /* Dezelfde maat als de footerbalk: de lijnen daar zijn gevulde banden
       van ~0.3–0.8 van een tegel-eenheid, en een eenheid is
       (100vw − 3rem) / 480. Non-scaling-stroke rekent in schermpixels, dus
       de dikte kan hier gewoon met de vensterbreedte meeschalen. */
    stroke-width: calc((100vw - 48px) / 960);
  }

  /* Het contact-segment loopt naar de footerbalk toe donkerder aan: van de
     tekstdekking bovenin (0.5 × 0.2 = 0.1) naar de volle balkdekking (0.5)
     op de landing. Gebruik: dekking={0.5} + deze klasse. */
  .stengel-verloop svg {
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.2) 0%,
      rgb(0 0 0 / 0.2) 45%,
      rgb(0 0 0) 100%
    );
  }

  /* Een loot groeit uit de stengel: gecentreerd op een waypoint, dus hij
     raakt de lijn altijd, hoe de sectie ook rekt. */
  .loot {
    position: absolute;
    width: 2.25rem;
    translate: -50% -50%;
    rotate: var(--draai);
    opacity: 0.3;
  }

  /* Het segment tekent zichzelf van boven naar beneden met een clip-wipe.
     Geen stroke-dash-draw: de combinatie dasharray + pathLength +
     non-scaling-stroke rendert in Chromium stuk (stippellijnen en afgekapte
     einden, ook in de eindstand). De stengel loopt vrijwel altijd omlaag,
     dus de wipe leest hetzelfde als tekenen langs het pad.
     Longhands, geen `animation:`-shorthand — zie global.css. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stengel svg {
        animation-name: stengel-groei;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }
  @keyframes stengel-groei {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0% 0); }
  }
</style>
