---
/**
 * Eén sectie-segment van de stengel (zie lib/stengel.ts en data/stengel.ts):
 * de vijflijnige notenbalk die als slingerpad door de pagina golft, van de
 * bloem in de omslag naar de liggende balk in de footer.
 *
 * De footerbalk is de bronwaarheid voor hoe een notenbalk er hier uitziet:
 * de stengel gebruikt exact diens lijnafstand en lijndikte, geschaald met
 * de segmentschaal (1.5–2× de footermaat, taperend naar 1 op de landing).
 *
 * Achtergrondlaag: absoluut, inset 0, z-index -1, aria-hidden. De sectie
 * eromheen moet een stapelcontext zijn (`<Sectie band>`). Haal het segment
 * weg en er verschuift niets.
 *
 * Alleen vanaf 80rem: daaronder bestaan de marges niet waar de stengel
 * doorheen slingert (het galerijgrid raakt daar bijna de vensterrand), en
 * verdwijnt ook de bloem waar hij uit groeit.
 */
import { stengelPaden, stengelPunt, TUSSEN } from '../../lib/stengel';
import { stengel, type StengelDeel } from '../../data/stengel';
import Sprig from './Sprig.astro';

interface Props {
  deel: StengelDeel;
  /** Dekking: 0.5 is de footerbalk (open zones), 0.35 één stap terug (bij tekst). */
  dekking?: number;
  /** Lijndikte t.o.v. de footerbalk; hou hem in de buurt van de segmentschaal. */
  dikte?: number;
  class?: string;
}
const { deel, dekking = 0.35, dikte = 1.5, class: className } = Astro.props;
const segment = stengel[deel];
const paden = stengelPaden(segment);

// Loten op t-waardes: gepositioneerd op de kromme, met een zijwaartse
// verschuiving tot nét buiten de buitenste lijn (halve waaier + halve
// sprig-breedte), om en om links en rechts zoals op de footerbalk.
const loten = (segment.loten ?? []).map((loot) => {
  const punt = stengelPunt(segment, loot.t);
  const x = punt.x + loot.kant * (2 * TUSSEN * punt.schaal + 1.5);
  return { ...loot, x, y: punt.y };
});
---

<div class:list={['stengel', className]} aria-hidden="true" style={`--dikte: ${dikte};`}>
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" style={`opacity: ${dekking};`}>
    {paden.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  </svg>
  {
    loten.map((loot) => (
      <span
        class="loot"
        style={`left: ${Math.round(loot.x * 100) / 100}%; top: ${Math.round(loot.y * 100) / 100}%; --draai: ${loot.draai ?? 0}deg;`}
      >
        <Sprig name={loot.naam} class="w-full" />
      </span>
    ))
  }
</div>

<style>
  .stengel {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: none;
    color: var(--color-bordeaux);
    pointer-events: none;
  }
  @media (min-width: 80rem) {
    .stengel {
      display: block;
    }
  }
  .stengel svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .stengel path {
    fill: none;
    stroke: currentColor;
    /* De footermaat: de lijnen daar zijn gevulde banden van gemiddeld
       ~0.5 tegel-eenheid, en een eenheid is (100vw − 3rem) / 480.
       Non-scaling-stroke rekent in schermpixels, dus de dikte schaalt
       gewoon mee met de vensterbreedte; --dikte is de segmentschaal. */
    stroke-width: calc((100vw - 48px) / 960 * var(--dikte, 1.5));
  }

  /* Het contact-segment loopt naar de footerbalk toe donkerder aan: van de
     tekstdekking bovenin (0.5 × 0.7 = 0.35) naar de volle balkdekking (0.5)
     op de landing. Gebruik: dekking={0.5} + deze klasse. */
  .stengel-verloop svg {
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.7) 0%,
      rgb(0 0 0 / 0.7) 45%,
      rgb(0 0 0) 100%
    );
  }

  /* Een loot groeit uit de stengel, in de toon van de noten en bladvlaggen
     op de footerbalk (die liggen daar op 0.32 binnen een 0.5-laag). */
  .loot {
    position: absolute;
    width: 2.5rem;
    translate: -50% -50%;
    rotate: var(--draai);
    opacity: 0.4;
  }

  /* Het segment tekent zichzelf van boven naar beneden met een clip-wipe.
     Geen stroke-dash-draw: de combinatie dasharray + pathLength +
     non-scaling-stroke rendert in Chromium stuk (stippellijnen en afgekapte
     einden, ook in de eindstand). De stengel loopt vrijwel altijd omlaag,
     dus de wipe leest hetzelfde als tekenen langs het pad.

     De range pint de teken-tip op 60% van de viewporthoogte: de reveal
     begint als de sectietop die lijn passeert (cover-start + 40vh) en
     eindigt als de sectievoet hem passeert (cover-eind − 60vh). Scroll-
     driven animations zijn afgeleide staat — ook na End, ankerlinks of een
     herlaad halverwege staat alles boven de tip getekend.
     Longhands, geen `animation:`-shorthand — zie global.css. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stengel svg {
        animation-name: stengel-groei;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 40vh cover calc(100% - 60vh);
      }
      .stengel .loot {
        animation-name: loot-op;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 40vh cover calc(100% - 60vh);
      }
      /* Het laatste segment moet af zijn op maximale scroll, maar de footer
         eronder is korter dan 40% viewport: de sectievoet komt nooit boven
         de (100vh − footerhoogte)-lijn uit en haalt de 60%-lijn dus net
         niet. De tip zakt hier geleidelijk mee naar de 68%-lijn. */
      .stengel-verloop svg,
      .stengel-verloop .loot {
        animation-range: cover 40vh cover calc(100% - 68vh);
      }
    }
  }
  @keyframes stengel-groei {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0% 0); }
  }
  /* Loten kunnen niet met de svg meewipen (ze staan erbuiten); ze faden in
     terwijl de tip hun sectie doorloopt. */
  @keyframes loot-op {
    from { opacity: 0; }
    to { opacity: 0.4; }
  }
</style>
