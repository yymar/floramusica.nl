---
/**
 * De lintvarianten die deze pagina herhaalt, één keer als <symbol>. De
 * textuurbanden en het notenbalkslot verwijzen er met <use> naar; zonder dit
 * zou elk van die twaalf tegels zijn eigen padgegevens meedragen.
 *
 * Staat in de layout en niet in een sectie: symbolen zijn paginabreed en
 * moeten er ook zijn voor een band die pas verderop komt.
 *
 * De centerline hoort hier bewust niet bij: de draw-animatie stuurt
 * `stroke-dashoffset` op het pad zelf, en CSS komt de shadow tree van een
 * <use> niet in. Dat lint gaat dus gewoon inline (het is 200 bytes).
 */
import { lintSymbool } from './svg';

const symbolen = [
  ['a', 'quiet'],
  ['b', 'quiet'],
  ['a', 'noten'],
  ['b', 'noten'],
  ['a', 'blad'],
  ['b', 'blad'],
] as const;
---

<svg class="lint-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs set:html={symbolen.map(([naam, variant]) => lintSymbool(naam, variant)).join('')} />
</svg>

<style>
  .lint-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
