---
/**
 * Het grote sier-motief (klarinet met bloei) uit de assetset, inline zodat
 * het `currentColor` volgt. Puur decoratief: `aria-hidden`, niet focusbaar,
 * en het mag nooit tekst overlappen zonder rustig vlak eronder.
 *
 * Varianten — zie MANIFEST.md:
 *   full  → voorgrond, vol detail. Eén per pagina; dit is het zwaarste
 *           bestand van de set (~28 kB inline).
 *   quiet → vereenvoudigd silhouet, uitsluitend als achtergrondwatermerk
 *           op 8–15% dekking. Boven 15% wint het van de tekst.
 *
 * Kleur komt van de omgeving: `text-bordeaux` op papier, `text-paper` op het
 * bordeaux vlak. Geef de dekking mee via een utility (`opacity-[0.12]`).
 *
 * Maat zet je op het element zelf (`class="w-64"`); de viewBox levert de
 * verhouding, dus `h-auto` houdt de layout stabiel — geen CLS.
 */
import { motiefSvg, type MotiefNaam } from './svg';

interface Props {
  name: MotiefNaam;
  variant?: 'full' | 'quiet';
  class?: string;
}
const { name, variant = 'full', class: className = '' } = Astro.props;

const svg = motiefSvg(name, variant, `block h-auto ${className}`);
---

<Fragment set:html={svg} />
