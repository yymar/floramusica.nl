---
/**
 * Klein plantaardig accent (takje, bloem, solsleutel, noten-blad) uit de
 * assetset. Inline, `aria-hidden`, decoratief.
 *
 * Terughoudend gebruiken. DESIGN.md houdt de pagina tussen omslag en slot
 * bewust stil: hoogstens één of twee takjes per sectie, in de marge of aan
 * een hoek, nooit naast lopende tekst.
 *
 * Varianten — zie MANIFEST.md:
 *   full  → voorgrond-accent, vol detail
 *   quiet → achtergrondwatermerk op 8–15% dekking (alleen `tak-blad` en
 *           `sol-sleutel` hebben er een; de rest is full-only)
 *
 * Geef altijd een breedte mee (`class="w-6"`, `class="w-full"`): het
 * component zet alleen `h-auto`, zodat de viewBox de verhouding levert en
 * de layout niet verspringt.
 */
import { takjeSvg, type TakjeNaam } from './svg';

interface Props {
  name: TakjeNaam;
  variant?: 'full' | 'quiet';
  class?: string;
}
const { name, variant = 'full', class: className = '' } = Astro.props;

const svg = takjeSvg(name, variant, `block h-auto ${className}`);
---

<Fragment set:html={svg} />
