---
/**
 * Het partituur-motief van de omslag: een notenbalk die van rand tot rand
 * loopt met een solsleutel aan het begin, toon-op-toon op het bordeaux
 * vlak. Sleutel, noten, bloemen en blad zijn allemaal Imkes handgetekende
 * tekeningen (Procreate), in dezelfde bordeaux als de balklijnen
 * (#7b1e2b = --color-bordeaux), dus de vaste PNG-kleur valt samen met
 * currentColor van de lijnen.
 *
 * Coordinaten in font-units: notenbalklijnen op y 0..1000 (4 x 250),
 * na scale(1,-1) op schermcoordinaten 0..-1000; de G-lijn ligt op -250.
 * Alles is als <image> geplaatst; de bezetting hieronder zet nootkoppen
 * op of net onder een balklijn (`bodem` is de onderrand van de tekening
 * in schermcoordinaten, de hoogte bepaalt hoe ver stok en blad reiken).
 *
 * De eerste maat leeft: elk ornament wiegt traag om zijn voet, als een
 * tuin in een lichte bries. Reduced motion zet alles stil.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
import sleutelImke from '../assets/imke-sleutel-bordeaux.png';
import { tekening, type TekeningNaam } from './ornaments/tekeningen';
// Hoogte in font-units; breedte volgt de verhouding van de tekening.
// Bijna de volle viewBox-hoogte (1756): de sleutel mag ruim boven en
// onder de balk uitsteken, zoals een echte solsleutel.
const H = 1550;
const W = Math.round((H * sleutelImke.width) / sleutelImke.height);

// De bezetting van de eerste regel, van links naar rechts. Gevulde koppen
// (a-varianten): die lezen op deze schaal het best. De bloemen en het blad
// staan óp de balk, tussen de noten — de tuin groeit door de partituur.
type Plek = { naam: TekeningNaam; x: number; hoogte: number; bodem: number };
const bezetting: Plek[] = [
  { naam: 'noot-2a', x: 2100, hoogte: 700, bodem: -180 },
  { naam: 'noot-5a', x: 3000, hoogte: 620, bodem: -430 },
  { naam: 'bloem-2', x: 4150, hoogte: 460, bodem: -220 },
  { naam: 'noot-3a', x: 5250, hoogte: 850, bodem: -180 },
  { naam: 'noot-7a', x: 6600, hoogte: 560, bodem: -180 },
  { naam: 'blad-2', x: 8000, hoogte: 380, bodem: 10 },
  { naam: 'noot-1a', x: 8900, hoogte: 700, bodem: 70 },
  { naam: 'noot-6a', x: 9900, hoogte: 620, bodem: -430 },
  { naam: 'bloem-1', x: 11200, hoogte: 500, bodem: 30 },
  // Voorbij het portret gaat de regel gewoon door: de viewBox toont bij
  // 2560px breed zo'n 21600 eenheden, dus de tuin loopt door tot daar —
  // de balk mag nergens kaal ophouden.
  { naam: 'noot-5a', x: 12400, hoogte: 620, bodem: -430 },
  { naam: 'noot-2a', x: 13500, hoogte: 700, bodem: -180 },
  { naam: 'blad-1', x: 14700, hoogte: 380, bodem: 10 },
  { naam: 'noot-7a', x: 15600, hoogte: 560, bodem: -180 },
  { naam: 'noot-4a', x: 16800, hoogte: 850, bodem: -180 },
  { naam: 'bloem-2', x: 18000, hoogte: 460, bodem: -220 },
  { naam: 'noot-6a', x: 19100, hoogte: 620, bodem: -430 },
  { naam: 'noot-1a', x: 20200, hoogte: 700, bodem: 70 },
  { naam: 'blad-2', x: 21400, hoogte: 380, bodem: 10 },
];
const plekken = bezetting.map((p) => {
  const beeld = tekening(p.naam);
  return {
    href: beeld.src,
    x: p.x,
    y: p.bodem - p.hoogte,
    width: Math.round((p.hoogte * beeld.width) / beeld.height),
    height: p.hoogte,
  };
});
---

<svg
  viewBox="120 -1098 30000 1756"
  preserveAspectRatio="xMinYMid slice"
  aria-hidden="true"
  class:list={['partituur pointer-events-none block w-full', className]}
>
  <g transform="scale(1,-1)">
    {[0, 250, 500, 750, 1000].map((y) => (
      <line x1="0" y1={y} x2="40000" y2={y} stroke="currentColor" stroke-width="14" opacity="0.75" />
    ))}
  </g>
  {/* Iets vrij van de linkerrand, verticaal net onder de viewBox-top zodat
      de krul (op ~60% van de tekening) rond de onderste balklijnen valt. */}
  <image href={sleutelImke.src} x="450" y="-1068" width={W} height={H} />
  {plekken.map((p) => <image class="orn" {...p} />)}
</svg>

<script>
  // Wind: strijkt de muis langs de regel, dan buigen de ornamenten mee en
  // veren gedempt terug. Elke tekening is een veer (hoek + hoeksnelheid);
  // een muisbeweging in de buurt geeft een impuls die schaalt met de
  // muissnelheid en meeduwt in de bewegingsrichting. De uitslag gaat via
  // de `transform`-property en componeert dus met de trage wieg/zweef
  // (individuele rotate/translate) — zelfde voet als draaipunt.
  const ornamenten = [...document.querySelectorAll<SVGImageElement>('.partituur .orn')];
  const rustig = matchMedia('(prefers-reduced-motion: reduce)');
  if (ornamenten.length) {
    const STIJF = 32; // veerconstante (1/s²) → slingerperiode ~1.1s
    const DEMP = 2.6; // demping: een paar keer naveren, dan stil
    const BEREIK = 150; // px rond de muis waarbinnen de wind vat heeft
    const KRACHT = 42; // impuls (deg/s) per px/ms muissnelheid op afstand 0
    const veren = ornamenten.map((el) => ({ el, hoek: 0, snelheid: 0 }));

    let vorige: { x: number; y: number; t: number } | null = null;
    let bezig = false;
    let vorigTik = 0;

    const tik = (nu: number) => {
      const dt = Math.min(0.05, (nu - vorigTik) / 1000);
      vorigTik = nu;
      let actief = false;
      for (const veer of veren) {
        veer.snelheid += (-STIJF * veer.hoek - DEMP * veer.snelheid) * dt;
        veer.hoek += veer.snelheid * dt;
        if (Math.abs(veer.hoek) > 0.05 || Math.abs(veer.snelheid) > 0.5) {
          actief = true;
          veer.el.style.transform = `rotate(${Math.round(veer.hoek * 100) / 100}deg)`;
        } else if (veer.hoek !== 0 || veer.snelheid !== 0) {
          veer.hoek = 0;
          veer.snelheid = 0;
          veer.el.style.transform = '';
        }
      }
      if (actief) requestAnimationFrame(tik);
      else bezig = false;
    };

    addEventListener(
      'pointermove',
      (e) => {
        if (rustig.matches || e.pointerType !== 'mouse') {
          vorige = null;
          return;
        }
        const nu = performance.now();
        const was = vorige;
        vorige = { x: e.clientX, y: e.clientY, t: nu };
        if (!was || nu - was.t <= 0 || nu - was.t > 120) return;
        const snelheid = Math.min(3, Math.hypot(e.clientX - was.x, e.clientY - was.y) / (nu - was.t));
        if (snelheid < 0.08) return;
        const richting = Math.sign(e.clientX - was.x) || 1;
        let geraakt = false;
        for (const veer of veren) {
          const r = veer.el.getBoundingClientRect();
          if (!r.width) continue; // verborgen (achter het klarinetmotief)
          const afstand = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
          if (afstand >= BEREIK) continue;
          veer.snelheid += richting * snelheid * (1 - afstand / BEREIK) * KRACHT;
          // Harde wind blijft een bries: cap op de slingersnelheid.
          veer.snelheid = Math.max(-110, Math.min(110, veer.snelheid));
          geraakt = true;
        }
        if (geraakt && !bezig) {
          bezig = true;
          vorigTik = nu;
          requestAnimationFrame(tik);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* De bries: wiegen om de voet (de nootkop, de bloembodem) plus een trage
     zweef, elk met eigen tempo en fase zodat het nooit synchroon marcheert.
     Twee losse animaties op de individuele transformproperties (rotate en
     translate), zodat de ritmes vrij tegen elkaar in lopen. De maten staan
     in viewBox-eenheden: ~8.4 eenheid is 1 schermpixel, dus de zweef van
     ~30 eenheden is een kleine 4px — levendig, geen carrousel. */
  @media (prefers-reduced-motion: no-preference) {
    .orn {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation:
        wiegen 7s ease-in-out infinite alternate,
        zweven 5.6s ease-in-out infinite alternate;
    }
    .orn:nth-of-type(2n) {
      animation-duration: 8.5s, 6.4s;
      animation-delay: -3.2s, -1.4s;
    }
    .orn:nth-of-type(3n) {
      animation-duration: 6.2s, 4.9s;
      animation-delay: -1.6s, -3.1s;
    }
    .orn:nth-of-type(3n + 1) {
      animation-delay: -5.1s, -2.2s;
    }
  }
  @keyframes wiegen {
    from {
      rotate: -2.4deg;
    }
    to {
      rotate: 2.6deg;
    }
  }
  @keyframes zweven {
    from {
      translate: 0 6px;
    }
    to {
      translate: 0 -26px;
    }
  }
</style>
