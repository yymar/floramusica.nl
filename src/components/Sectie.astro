---
/**
 * Het marge-grid van het programmaboekje: op desktop staat het sectielabel
 * in de linkermarge op de baseline van de kop, de inhoud in de brede
 * rechterkolom. Op mobiel klapt het naar een kolom, label boven kop.
 *
 * `tint` geeft de sectie een iets dieper papier als achtergrond,
 * voor rustige afwisseling binnen hetzelfde lichte thema.
 *
 * De kop wordt in woorden gesplitst (`.wrd`), zodat hij bij het inscrollen
 * per woord opbouwt — zie MOTION.md. Woorden en geen regels, want waar een
 * regel breekt is in statische CSS niet te weten. De choreografie loopt tot
 * vier stappen, dus alles vanaf het vierde woord blijft één span; koppen
 * hier zijn kort, dus dat valt in de praktijk nooit op.
 *
 * `sier` zet een klein plantaardig accent in de labelkolom: de marge van
 * het programmaboekje, naast de kop waar het bij hoort. Accentmaat (32–40px),
 * nooit in de tekstkolom.
 *
 * `band` maakt de sectie een stapelcontext, zodat een `<Stengel>` in de
 * `band`-slot met `z-index: -1` achter alle inhoud kan
 * liggen en over de sectiegrens heen mag hangen. Werkt ook op getinte
 * secties: de eigen achtergrond van een stapelcontext schildert onder zijn
 * negatieve z-kinderen.
 */
import Sprig from './ornaments/Sprig.astro';
import type { TakjeNaam } from './ornaments/svg';

interface Props {
  id: string;
  label: string;
  kop: string;
  tint?: boolean;
  sier?: TakjeNaam;
  band?: boolean;
}
const { id, label, kop, tint = false, sier, band = false } = Astro.props;

const woorden = kop.split(' ').filter(Boolean);
const delen = woorden.length > 4 ? [...woorden.slice(0, 3), woorden.slice(3).join(' ')] : woorden;
---

<section id={id} class:list={[tint && 'bg-paper-deep', band && 'draagt-band']}>
  <slot name="band" />
  <div class="mx-auto max-w-5xl px-5 py-sectie sm:px-8">
    <div class="md:grid md:grid-cols-[10rem_1fr] md:gap-10 lg:grid-cols-[12rem_1fr]">
      <div class="labelkolom mb-2 md:mb-0 md:self-start md:pt-[0.6em]">
        {sier && <Sprig name={sier} class="sier" />}
        <p class="text-klein font-bold text-bordeaux" aria-hidden="true">{label}</p>
      </div>
      <div>
        <h2 class="font-display text-kop font-semibold tracking-tight text-ink">
          {
            delen.map((woord, i) => (
              <>
                {i > 0 && ' '}
                <span class="wrd">{woord}</span>
              </>
            ))
          }
        </h2>
        <div class="mt-6">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* De stapelcontext voor de band-slot. Op een getinte sectie alleen vanaf
     80rem (waar de stengel bestaat): daaronder zou de tintachtergrond, die
     dan boven de laag van het binnenwerk komt, de maatstreep afdekken. */
  .draagt-band:not(.bg-paper-deep) {
    position: relative;
    z-index: 0;
  }
  @media (min-width: 80rem) {
    .draagt-band {
      position: relative;
      z-index: 0;
    }
  }

  /* Het accent staat in de open goot links van het label, op de regel van
     de kop — niet eronder, waar het tegen de inhoud van de sectie aan kan
     lopen. Onder het marge-grid (48rem) bestaat die goot niet en is het
     accent er niet: het zou het label opzij duwen, en accenten verplaatsen
     nooit tekst. */
  .labelkolom {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .labelkolom :global(.sier) {
    display: none;
    width: 2.25rem;
    flex: none;
    color: var(--color-bordeaux);
    opacity: 0.45;
  }
  @media (min-width: 48rem) {
    .labelkolom :global(.sier) {
      display: block;
    }
  }
</style>
