---
/**
 * De wordmark van Flora Musica: de forte-f en mezzo-m uit de bladmuziek
 * (Bravura, SIL OFL) gecombineerd met Bricolage. Alle maten in em,
 * dus de wordmark schaalt mee met de font-size van de context.
 *
 * `toon` bepaalt de kleur: 'bordeaux' op licht papier, 'paper' op het
 * bordeaux vlak. Het bijpassende beeldmerk staat in public/favicon.svg.
 */
import { forteF, mezzoM } from '../data/dynamiek';

interface Props {
  toon?: 'bordeaux' | 'paper';
}
const { toon = 'bordeaux' } = Astro.props;
---

<span class:list={['inline-flex items-baseline', toon === 'paper' ? 'text-paper' : 'text-bordeaux']}>
  <span class="sr-only">Flora Musica, muziekpraktijk</span>
  <span class="inline-flex items-baseline font-display font-semibold tracking-[-0.015em]" aria-hidden="true">
    <svg
      viewBox={forteF.viewBox}
      class="h-[1.35em] w-[1.15em] overflow-visible"
      style="margin-right: -0.33em"
    ><g transform="scale(1,-1)"><path d={forteF.pad} fill="currentColor" /></g></svg>
    <span>lora</span>
    <span class="w-[0.33em]"></span>
    <svg
      viewBox={mezzoM.viewBox}
      class="h-[0.69em] w-[1.12em] overflow-visible"
      style="margin-right: 0.04em"
    ><g transform="scale(1,-1)"><path d={mezzoM.pad} fill="currentColor" /></g></svg>
    <span>usica</span>
  </span>
</span>
