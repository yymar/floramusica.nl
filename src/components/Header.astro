---
/**
 * Sticky header. De hero begint op bordeaux, dus de header is zelf ook
 * bordeaux en gaat naadloos over in het hero-vlak.
 *
 * Onder 48rem past de volledige ankerlijst niet naast het woordmerk (in het
 * Engels al vanaf ~41rem niet meer). Daar staat hij in een `<details>`-
 * uitklap: native, dus toetsenbordbedienbaar en schermlezer-correct zonder
 * eigen ARIA, en zichtbaar zonder JavaScript. Het script sluit de lade
 * nadat je een anker kiest, bij Esc en bij een tik ernaast — anders blijft
 * hij over de sectie liggen waar je net heen sprong.
 *
 * De ankers krijgen het pad van de voorpagina ervoor, zodat het menu ook
 * werkt op /bedankt en de 404. Op de voorpagina zelf blijft het een sprong
 * binnen de pagina.
 */
import Wordmark from './Wordmark.astro';
import { navigatie } from '../data/navigatie';
import { copy, taalVan } from '../data/copy';

const taal = taalVan(Astro.currentLocale);
const { basis } = copy(Astro.currentLocale);
const items = navigatie(Astro.currentLocale);
const ankers = items.filter((item) => item.anker !== '#contact');
const contact = items.find((item) => item.anker === '#contact');

// De taalwissel wijst naar dezelfde pagina in de andere taal: /en/ ervoor
// of eraf. De ankers zijn taalonafhankelijk, dus die blijven werken.
// De 404 heeft geen Engelse tegenhanger: daar gaat de knop naar /en/.
const nlPad = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const anderTaalPad = nlPad.startsWith('/404')
  ? (taal === 'en' ? '/' : '/en/')
  : taal === 'en' ? nlPad : nlPad === '/' ? '/en/' : `/en${nlPad}`;
const thuis = taal === 'en' ? '/en/' : '/';
const andereTaal = taal === 'en' ? 'nl' : 'en';
---

<header class="sticky top-0 z-40 bg-bordeaux-deep" data-vlak="bordeaux">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href={`${thuis}#top`} class="inline-flex items-center py-2 text-[1.2rem]">
      <Wordmark toon="paper" />
    </a>

    <nav aria-label={basis.navLabel} class="flex items-center gap-3 sm:gap-6">
      {/* Vanaf 48rem staan de ankers gewoon op een rij. */}
      <ul class="hidden items-center gap-6 md:flex">
        {
          ankers.map((item) => (
            <li>
              <a href={thuis + item.anker} class="nav-link inline-block py-3 text-klein text-paper-dim transition-colors hover:text-paper">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Daaronder een uitklap. */}
      <details class="menu md:hidden">
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-sm px-2 text-klein text-paper-dim transition-colors hover:text-paper"
        >
          <span class="menu-streepjes" aria-hidden="true"></span>
          {/* Op de smalste schermen alleen de streepjes; het woord blijft
              voor schermlezers. */}
          <span class="max-[22.5rem]:sr-only">{basis.menu}</span>
        </summary>
        <ul class="menu-lade">
          {
            ankers.map((item) => (
              <li>
                <a href={thuis + item.anker} class="block px-5 py-3 text-paper-dim transition-colors hover:text-paper">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      {
        contact && (
          <a
            href={thuis + contact.anker}
            class="rounded-sm border border-paper-dim px-3 py-1.5 text-klein font-bold text-paper transition-colors hover:bg-paper hover:text-bordeaux-deep"
          >
            {contact.label}
          </a>
        )
      }

      {/* Taalwissel: klein kapitaal, zelfde stem als de sectielabels. */}
      <a
        href={anderTaalPad}
        hreflang={andereTaal}
        lang={andereTaal}
        aria-label={basis.andereTaalLabel}
        class="nav-link taal-link inline-block px-1 py-3 text-klein text-paper-dim transition-colors hover:text-paper"
      >
        {basis.andereTaalKnop}
      </a>
    </nav>
  </div>
</header>

<script>
  // Sluit de lade nadat er een anker is gekozen, bij Esc en bij een tik of
  // focus ernaast; anders blijft hij over de sectie liggen.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('focusout', (e) => {
      if (menu.open && !menu.contains(e.relatedTarget as Node | null)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }

  // De taalknop is een expliciete keuze: bewaren, zodat de automatische
  // taalcheck (Basis.astro) er nooit meer overheen stuurt.
  const taalLink = document.querySelector<HTMLAnchorElement>('.taal-link');
  taalLink?.addEventListener('click', () => {
    try {
      localStorage.setItem('fm:taalkeuze', taalLink.getAttribute('hreflang') ?? 'nl');
    } catch {
      /* geen opslag beschikbaar */
    }
  });
</script>

<style>
  /* Micro-interactie (MOTION.md): de onderstreping groeit vanaf links in
     plaats van er in één keer te staan. Pseudo-element, want een border zou
     de regelhoogte veranderen. Dezelfde taal als de groeiende hairlines in
     Lessen, Locatie en het notenbalkslot. */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.5rem;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-m) var(--ease-organic);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
  .taal-link {
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  /* De uitklap. Drie hairlines in plaats van een icoonfont: dezelfde
     lijntaal als de notenbalk en de sectie-hairlines. */
  .menu {
    position: relative;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-streepjes {
    display: block;
    width: 1.1rem;
    height: 0.5rem;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    position: relative;
  }
  .menu-streepjes::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% - 0.5px);
    height: 1px;
    background: currentColor;
  }
  .menu-lade {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    min-width: 11rem;
    background: var(--color-bordeaux-deep);
    border: 1px solid color-mix(in srgb, var(--color-paper-dim) 40%, transparent);
    border-radius: 2px;
    padding-block: 0.25rem;
    box-shadow: var(--schaduw-overhang);
  }
</style>
