---
/**
 * Sticky header. De hero begint op bordeaux, dus de header is zelf ook
 * bordeaux en gaat naadloos over in het hero-vlak.
 *
 * Onder 40rem past de volledige ankerlijst niet naast het woordmerk. Daar
 * staat hij in een `<details>`-uitklap: native, dus toetsenbordbedienbaar en
 * schermlezer-correct zonder eigen ARIA, en zichtbaar zonder JavaScript. Het
 * enige script is één regel die de lade sluit nadat je een anker kiest —
 * zonder dat zou hij over de sectie blijven staan waar je net heen sprong.
 */
import Wordmark from './Wordmark.astro';
import { navigatie } from '../data/navigatie';

const ankers = navigatie.filter((item) => item.anker !== '#contact');
const contact = navigatie.find((item) => item.anker === '#contact');
---

<header class="sticky top-0 z-40 bg-bordeaux-deep" data-vlak="bordeaux">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="#top" class="inline-flex items-center py-2 text-[1.2rem]">
      <Wordmark toon="paper" />
    </a>

    <nav aria-label="Hoofdnavigatie" class="flex items-center gap-3 sm:gap-6">
      {/* Vanaf 40rem staan de ankers gewoon op een rij. */}
      <ul class="hidden items-center gap-6 sm:flex">
        {
          ankers.map((item) => (
            <li>
              <a href={item.anker} class="nav-link text-klein text-paper-dim transition-colors hover:text-paper">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Daaronder een uitklap. */}
      <details class="menu sm:hidden">
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded-sm px-2 py-1.5 text-klein text-paper-dim transition-colors hover:text-paper"
        >
          <span class="menu-streepjes" aria-hidden="true"></span>
          Menu
        </summary>
        <ul class="menu-lade">
          {
            ankers.map((item) => (
              <li>
                <a href={item.anker} class="block px-5 py-3 text-paper-dim transition-colors hover:text-paper">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      {
        contact && (
          <a
            href={contact.anker}
            class="rounded-sm border border-paper-dim px-3 py-1.5 text-klein font-bold text-paper transition-colors hover:bg-paper hover:text-bordeaux-deep"
          >
            {contact.label}
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  // Sluit de lade nadat er een anker is gekozen; anders blijft hij openstaan
  // over de sectie waar je net heen bent gesprongen.
  document.querySelector('.menu')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      (document.querySelector('.menu') as HTMLDetailsElement).open = false;
    }
  });
</script>

<style>
  /* Micro-interactie (MOTION.md): de onderstreping groeit vanaf links in
     plaats van er in één keer te staan. Pseudo-element, want een border zou
     de regelhoogte veranderen. Dezelfde taal als de groeiende hairlines in
     Lessen, Locatie en het notenbalkslot. */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-m) var(--ease-organic);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* De uitklap. Drie hairlines in plaats van een icoonfont: dezelfde
     lijntaal als de notenbalk en de sectie-hairlines. */
  .menu {
    position: relative;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-streepjes {
    display: block;
    width: 1.1rem;
    height: 0.5rem;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    position: relative;
  }
  .menu-streepjes::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% - 0.5px);
    height: 1px;
    background: currentColor;
  }
  .menu-lade {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    min-width: 11rem;
    background: var(--color-bordeaux-deep);
    border: 1px solid color-mix(in srgb, var(--color-paper-dim) 40%, transparent);
    border-radius: 2px;
    padding-block: 0.25rem;
    box-shadow: var(--schaduw-overhang);
  }
</style>
