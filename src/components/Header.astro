---
/**
 * Sticky header. De hero begint op bordeaux, dus de header is zelf ook
 * bordeaux en gaat naadloos over in het hero-vlak.
 */
import Wordmark from './Wordmark.astro';
import { navigatie } from '../data/navigatie';
---

<header class="sticky top-0 z-40 bg-bordeaux-deep" data-vlak="bordeaux">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="#top" class="inline-flex items-center py-2 text-[1.2rem]">
      <Wordmark toon="paper" />
    </a>
    <nav aria-label="Hoofdnavigatie">
      <ul class="flex items-center gap-4 sm:gap-6">
        {
          navigatie.map((item) => (
            <li class:list={[item.anker !== '#contact' && 'hidden sm:block']}>
              <a
                href={item.anker}
                class:list={[
                  'text-klein transition-colors',
                  item.anker === '#contact'
                    ? 'rounded-sm border border-paper-dim px-3 py-1.5 font-bold text-paper hover:bg-paper hover:text-bordeaux-deep'
                    : 'nav-link text-paper-dim hover:text-paper',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Micro-interactie (MOTION.md): de onderstreping groeit vanaf links in
     plaats van er in één keer te staan. Pseudo-element, want een border zou
     de regelhoogte veranderen. Dezelfde taal als de groeiende hairlines in
     Lessen, Locatie en het notenbalkslot. */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-m) var(--ease-organic);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
</style>
