---
/**
 * Afbeeldingsslot. Zolang er geen foto is, rendert dit een rustig
 * placeholder-vlak met de juiste verhoudingen; zodra `src` een geïmporteerde
 * afbeelding is, rendert het Astro's <Image> (lazy, expliciete afmetingen).
 *
 * Foto toevoegen: importeer de afbeelding in de sectie en geef hem door.
 *   import portret from '../assets/portret.jpg';
 *   <Figuur src={portret} alt="..." breedte={560} hoogte={700} />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  breedte: number;
  hoogte: number;
  /** Omschrijving van de foto die hier nog moet komen. */
  todo?: string;
  class?: string;
}
const { src, alt, breedte, hoogte, todo, class: className } = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      width={breedte}
      height={hoogte}
      loading="lazy"
      class:list={['h-auto w-full rounded-sm object-cover', className]}
    />
  ) : (
    <div
      class:list={[
        'flex w-full items-center justify-center rounded-sm border border-rule bg-paper-deep p-6',
        className,
      ]}
      style={`aspect-ratio: ${breedte} / ${hoogte};`}
      role="img"
      aria-label={alt}
    >
      <p class="max-w-[24ch] text-center text-klein text-ink-soft">
        {todo ?? 'TODO: foto aanleveren'}
      </p>
    </div>
  )
}
