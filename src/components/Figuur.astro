---
/**
 * Afbeeldingsslot. Zolang er geen foto is, rendert dit een rustig
 * placeholder-vlak met de juiste verhoudingen; zodra `src` een geïmporteerde
 * afbeelding is, rendert het Astro's <Image> (lazy, expliciete afmetingen).
 *
 * `toon` maakt de placeholder passend bij de ondergrond: op het bordeaux
 * vlak een tonale outline in plaats van een licht vlak, zodat het slot
 * niet alle aandacht trekt.
 *
 * Foto toevoegen: importeer de afbeelding in de sectie en geef hem door.
 *   import portret from '../assets/portret.jpg';
 *   <Figuur src={portret} alt="..." breedte={560} hoogte={700} />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  breedte: number;
  hoogte: number;
  toon?: 'paper' | 'bordeaux';
  /** Korte omschrijving van de foto die hier nog komt. */
  todo?: string;
  class?: string;
}
const { src, alt, breedte, hoogte, toon = 'paper', todo, class: className } = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      width={breedte}
      height={hoogte}
      loading="lazy"
      class:list={['h-auto w-full rounded-sm object-cover', className]}
    />
  ) : (
    <div
      class:list={[
        'flex w-full items-center justify-center rounded-sm border p-6',
        toon === 'bordeaux'
          ? 'border-paper-dim/40 bg-transparent'
          : 'border-rule bg-paper-deep',
        className,
      ]}
      style={`aspect-ratio: ${breedte} / ${hoogte};`}
      role="img"
      aria-label={alt}
    >
      <p
        class:list={[
          'max-w-[24ch] text-center text-klein',
          toon === 'bordeaux' ? 'text-paper-dim/80' : 'text-ink-soft',
        ]}
      >
        {todo ?? 'Foto volgt'}
      </p>
    </div>
  )
}
