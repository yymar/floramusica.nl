---
/** Engelse variant van /bedankt (Web3Forms-redirect vanaf de /en/-route). */
import Basis from '../../layouts/Basis.astro';
import { copy } from '../../data/copy';
const { bedankt } = copy(Astro.currentLocale);
---

<Basis titel={bedankt.titel} noindex>
  <section class="mx-auto max-w-5xl px-5 py-sectie sm:px-8">
    <h1 class="font-display text-kop font-semibold tracking-tight">{bedankt.titel}</h1>
    <p class="mt-4 max-w-[62ch]">{bedankt.tekst}</p>
    <p class="mt-8">
      <a href="/en/" class="font-bold text-bordeaux underline underline-offset-2 hover:text-bordeaux-deep">
        {bedankt.terug}
      </a>
    </p>
  </section>
</Basis>

<script>
  try {
    localStorage.removeItem('fm:contact-concept:v1');
  } catch {
    /* geen opslag beschikbaar */
  }
</script>
