---
import Basis from '../layouts/Basis.astro';
import Hero from '../sections/Hero.astro';
import Over from '../sections/Over.astro';
import Galerij from '../sections/Galerij.astro';
import Lessen from '../sections/Lessen.astro';
import Locatie from '../sections/Locatie.astro';
import Praktisch from '../sections/Praktisch.astro';
import Contact from '../sections/Contact.astro';
---

<Basis>
  <Hero />
  {/* Het binnenwerk: alles na de omslag. De wrapper draagt de maatstreep en
      klipt wat links (de galerij-spread) en rechts (de bordeaux golf) buiten
      de container bloedt. De omslag staat er bewust buiten, want het portret
      moet juist over de grens hangen. */}
  <div class="binnenwerk">
    <div class="maatstreep" aria-hidden="true"></div>
    <Over />
    <Galerij />
    <Lessen />
    <Locatie />
    <Praktisch />
    <Contact />
  </div>
</Basis>
